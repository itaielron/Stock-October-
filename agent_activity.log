│  {resp.text[:200]}")                                                         │
│                  break                                                       │
│              payload = resp.json() or {}                                     │
│              chunk = payload.get("bars") or []                               │
│              bars.extend(chunk)                                              │
│              token = payload.get("next_page_token")                          │
│              if not token:                                                   │
│                  break                                                       │
│              params["page_token"] = token                                    │
│      except Exception as exc:                                                │
│          log(f"[error] {symbol}: fetch failed: {exc}")                       │
│          return pd.DataFrame()                                               │
│                                                                              │
│      if not bars:                                                            │
│          log(f"[warn] {symbol}: no bars returned.")                          │
│          return pd.DataFrame()                                               │
│                                                                              │
│      df = pd.DataFrame(bars)                                                 │
│      df = df.rename(                                                         │
│          columns={                                                           │
│              "o": "Open",                                                    │
│              "h": "High",                                                    │
│              "l": "Low",                                                     │
│              "c": "Close",                                                   │
│              "v": "Volume",                                                  │
│              "vw": "VWAP",                                                   │
│              "n": "TradeCount",                                              │
│          }                                                                   │
│      )                                                                       │
│      if "t" not in df.columns:                                               │
│          log(f"[error] {symbol}: response missing timestamp column.")        │
│          return pd.DataFrame()                                               │
│                                                                              │
│      df["t"] = pd.to_datetime(df["t"], utc=True)                             │
│      df = df.set_index("t").sort_index()                                     │
│                                                                              │
│      keep = [c for c in ["Open", "High", "Low", "Close", "Volume", "VWAP",   │
│  "TradeCount"]                                                               │
│              if c in df.columns]                                             │
│      df = df[keep].astype(float)                                             │
│      return df                                                               │
│                                                                              │
│                                                                              │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│  # INDICATORS                                                                │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│                                                                              │
│  def calculate_indicators(df: pd.DataFrame) -> pd.DataFrame:                 │
│      """Add EMA9, EMA21, TR and ATR (and the ATR regime mean) to `df`."""    │
│      if df.empty:                                                            │
│          return df                                                           │
│                                                                              │
│      out = df.copy()                                                         │
│      out["EMA9"] = out["Close"].ewm(span=9, adjust=False).mean()             │
│      out["EMA21"] = out["Close"].ewm(span=21, adjust=False).mean()           │
│                                                                              │
│      prev_close = out["Close"].shift(1)                                      │
│      tr = pd.concat(                                                         │
│          [                                                                   │
│              out["High"] - out["Low"],                                       │
│              (out["High"] - prev_close).abs(),                               │
│              (out["Low"] - prev_close).abs(),                                │
│          ],                                                                  │
│          axis=1,                                                             │
│      ).max(axis=1)                                                           │
│      out["TR"] = tr                                                          │
│      out["ATR"] = tr.rolling(ATR_PERIOD).mean()                              │
│                                                                              │
│      # Volatility-regime reference level.                                    │
│      out["ATR_MEAN"] = out["ATR"].rolling(ATR_REGIME_WINDOW).mean()          │
│                                                                              │
│      return out                                                              │
│                                                                              │
│                                                                              │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│  # CHARTING                                                                  │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│                                                                              │
│  def generate_chart(                                                         │
│      df: pd.DataFrame,                                                       │
│      index,                                                                  │
│      entry: float,                                                           │
│      sl: float,                                                              │
│      tp1: float,                                                             │
│      tp2: float,                                                             │
│      outcome: str,                                                           │
│      symbol: str,                                                            │
│      swing_low: float | None = None,                                         │
│      swing_high: float | None = None,                                        │
│  ):                                                                          │
│      """                                                                     │
│      Render a candlestick chart around the trade with level overlays.        │
│                                                                              │
│      Signature stays backward compatible; `swing_low` / `swing_high` are     │
│      optional structure reference lines.                                     │
│      """                                                                     │
│      os.makedirs(CHARTS_DIR, exist_ok=True)                                  │
│                                                                              │
│      try:                                                                    │
│          pos = df.index.get_loc(index)                                       │
│      except KeyError:                                                        │
│          log(f"[warn] {symbol}: chart index {index} not found; skipping      │
│  chart.")                                                                    │
│          return None                                                         │
│      if isinstance(pos, slice) or isinstance(pos, np.ndarray):               │
│          pos = int(np.flatnonzero(np.asarray(pos))[0]) if                    │
│  len(np.asarray(pos)) else 0                                                 │
│                                                                              │
│      lo = max(0, pos - 20)                                                   │
│      hi = min(len(df), pos + 41)                                             │
│      window = df.iloc[lo:hi]                                                 │
│                                                                              │
│      if window.empty:                                                        │
│          log(f"[warn] {symbol}: empty chart window; skipping chart.")        │
│          return None                                                         │
│                                                                              │
│      hlines = dict(                                                          │
│          hlines=[entry, sl, tp1, tp2],                                       │
│          colors=["white", "red", "green", "green"],                          │
│          linestyle=["solid", "dashed", "dashed", "dashed"],                  │
│          linewidths=[1.0, 1.0, 1.0, 1.0],                                    │
│      )                                                                       │
│      if swing_low is not None:                                               │
│          hlines["hlines"].append(swing_low)                                  │
│          hlines["colors"].append("orange")                                   │
│          hlines["linestyle"].append("dotted")                                │
│          hlines["linewidths"].append(0.8)                                    │
│      if swing_high is not None:                                              │
│          hlines["hlines"].append(swing_high)                                 │
│          hlines["colors"].append("cyan")                                     │
│          hlines["linestyle"].append("dotted")                                │
│          hlines["linewidths"].append(0.8)                                    │
│                                                                              │
│      plot_df = window[["Open", "High", "Low", "Close", "Volume"]].copy()     │
│      addplots = []                                                           │
│      if "EMA9" in window.columns and "EMA21" in window.columns:              │
│          addplots = [                                                        │
│              mpf.make_addplot(window["EMA9"], color="blue", width=0.8),      │
│              mpf.make_addplot(window["EMA21"], color="red", width=0.8),      │
│          ]                                                                   │
│                                                                              │
│      ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")               │
│      fname = os.path.join(CHARTS_DIR, f"{outcome}_{symbol}_{ts}.png")        │
│                                                                              │
│      try:                                                                    │
│          mpf.plot(                                                           │
│              plot_df,                                                        │
│              type="candle",                                                  │
│              style="nightclouds",                                            │
│              addplot=addplots if addplots else None,                         │
│              hlines=hlines,                                                  │
│              volume=False,                                                   │
│              title=f"{symbol} {outcome} ({index})",                          │
│              savefig=fname,                                                  │
│          )                                                                   │
│      except Exception as exc:                                                │
│          log(f"[warn] {symbol}: chart generation failed: {exc}")             │
│          return None                                                         │
│                                                                              │
│      return fname                                                            │
│                                                                              │
│                                                                              │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│  # TRADE ENGINE HELPERS                                                      │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│                                                                              │
│  def _close_remainder(trade: dict, price: float, bar_time, reason: str) ->   │
│  None:                                                                       │
│      """Realize the remaining position at `price` and stamp the trade        │
│  closed."""                                                                  │
│      remaining = trade["remaining_size"]                                     │
│      if remaining > 0:                                                       │
│          contrib = ((price - trade["entry"]) / trade["initial_risk"]) *      │
│  remaining                                                                   │
│          trade["realized_R"] += contrib                                      │
│          trade["remaining_size"] = 0.0                                       │
│      trade["exit_price"] = price                                             │
│      trade["exit_time"] = bar_time                                           │
│      trade["exit_reason"] = reason                                           │
│      trade["closed"] = True                                                  │
│                                                                              │
│                                                                              │
│  def _scale_out(trade: dict, price: float, bar_time, reason: str) -> None:   │
│      """Close SCALE_OUT_FRACTION of the position at `price`."""              │
│      frac = min(SCALE_OUT_FRACTION, trade["remaining_size"])                 │
│      if frac <= 0:                                                           │
│          return                                                              │
│      contrib = ((price - trade["entry"]) / trade["initial_risk"]) * frac     │
│      trade["realized_R"] += contrib                                          │
│      trade["remaining_size"] -= frac                                         │
│      trade["scaled_out"] = True                                              │
│      trade["scale_price"] = price                                            │
│      trade["scale_time"] = bar_time                                          │
│      trade["scale_reason"] = reason                                          │
│                                                                              │
│                                                                              │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│  # BACKTEST                                                                  │
│  #                                                                           │
│  --------------------------------------------------------------------------  │
│  -                                                                           │
│                                                                              │
│  def run_backtest(start: str | None = None,                                  │
│                   end: str | None = None,                                    │
│                   symbols: list[str] | None = None):                         │
│      """                                                                     │
│      Run the full backtest. Returns (results, summary) where `results` is a  │
│      list of per-trade dicts and `summary` a dict of aggregate stats.        │
│      """                                                                     │
│      if symbols is None:                                                     │
│          symbols = ["SPY", "QQQ"]                                            │
│                                                                              │
│      if end is None:                                                         │
│          end_dt = datetime.now(timezone.utc)                                 │
│      else:                                                                   │
│          end_dt = pd.to_datetime(end, utc=True).to_pydatetime()              │
│      if start is None:                                                       │
│          start_dt = end_dt - timedelta(days=7)                               │
│      else:                                                                   │
│          start_dt = pd.to_datetime(start, utc=True).to_pydatetime()          │
│                                                                              │
│      start_iso = start_dt.strftime("%Y-%m-%dT%H:%M:%SZ")                     │
│      end_iso = end_dt.strftime("%Y-%m-%dT%H:%M:%SZ")                         │
│                                                                              │
│      os.makedirs(CHARTS_DIR, exist_ok=True)                                  │
│      log("=" * 70)                                                           │
│      log(f"Structure-aware backtest {start_iso} -> {end_iso}                 │
│  symbols={symbols}")                                                         │
│                                                                              │
│      results: list[dict] = []                                                │
│                                                                              │
│      for symbol in symbols:                                                  │
│          raw = fetch_data(symbol, start_iso, end_iso)                        │
│          if raw.empty:                                                       │
│              log(f"[warn] {symbol}: no data, skipping.")                     │
│              continue                                                        │
│                                                                              │
│          df = calculate_indicators(raw)                                      │
│          # Keep structure/indicator rows, drop the unusable head.            │
│          df.dropna(inplace=True)                                             │
│          n = len(df)                                                         │
│          if n <= WARMUP_BARS + LOOKBACK + 2:                                 │
│              log(f"[warn] {symbol}: only {n} bars after dropna; skipping.")  │
│              continue                                                        │
│                                                                              │
│          log(f"[info] {symbol}: {n} bars, backtesting...")                   │
│                                                                              │
│          i = max(WARMUP_BARS, LOOKBACK + 1, ATR_PERIOD + 1)                  │
│          i = min(i, n - 2)                                                   │
│                                                                              │
│          while i < n - 1:                                                    │
│              row = df.iloc[i]                                                │
│              atr = float(row["ATR"])                                         │
│              if not np.isfinite(atr) or atr <= 0:                            │
│                  i += 1                                                      │
│                  continue                                                    │
│                                                                              │
│              # --- signal: EMA9 crosses above EMA21                          │
│  -------------------------                                                   │
│              prev_ema9 = float(df["EMA9"].iloc[i - 1])                       │
│              prev_ema21 = float(df["EMA21"].iloc[i - 1])                     │
│              cur_ema9 = float(row["EMA9"])                                   │
│              cur_ema21 = float(row["EMA21"])                                 │
│              crossover = (prev_ema9 <= prev_ema21) and (cur_ema9 >           │
│  cur_ema21)                                                                  │
│                                                                              │
│              if not crossover:                                               │
│                  i += 1                                                      │
│                  continue                                                    │
│                                                                              │
│              # --- ATR regime filter (flaw C)                                │
│  -------------------------------                                             │
│              atr_mean = float(row["ATR_MEAN"]) if "ATR_MEAN" in df.columns   │
│  else float("nan")                                                           │
│              if np.isfinite(atr_mean) and atr_mean > 0:                      │
│                  if atr < ATR_REGIME_MIN_RATIO * atr_mean:                   │
│                      i += 1                                                  │
│                      continue                                                │
│                                                                              │
│              # --- distance gate (flaw H keeps gate, structure does the      │
│  anchoring)                                                                  │
│              if abs(float(row["Close"]) - cur_ema9) > DISTANCE_GATE_ATR *    │
│  atr:                                                                        │
│                  i += 1                                                      │
│                  continue                                                    │
│                                                                              │
│              bar_time = df.index[i]                                          │
│              entry = float(row["Close"])                                     │
│                                                                              │
│              # --- structural stop (flaw A)                                  │
│  --------------------------------                                            │
│              win_lo = max(0, i - LOOKBACK)                                   │
│              recent_swing_low = float(df["Low"].iloc[win_lo:i].min())        │
│              sl = recent_swing_low - (SL_BUFFER_ATR * atr) - TICK            │
│                                                                              │
│              # If structure puts the stop at/above entry the setup is        │
│  invalid.                                                                    │
│              if sl >= entry:                                                 │
│                  i += 1                                                      │
│                  continue                                                    │
│                                                                              │
│              risk = entry - sl                                               │
│                                                                              │
│              # --- minimum risk (flaw D)                                     │
│  -----------------------------------                                         │
│              if risk < MIN_RISK_ATR * atr:                                   │
│                  # Documented choice: SKIP rather than widen the stop.       │
│                  # Widening would contradict the structural level.           │
│                  i += 1                                                      │
│                  continue                                                    │
│                                                                              │
│              # --- structural targets (flaws D/H)                            │
│  --------------------------                                                  │
│              recent_swing_high = float(df["High"].iloc[win_lo:i].max())      │
│              tp1 = entry + TP1_R * risk                                      │
│              tp2_struct = entry + TP2_R * risk                               │
│              # Cap TP2 at the structural resistance only when that           │
│  resistance                                                                  │
│              # actually sits beyond TP1; otherwise keep the R-based TP2.     │
│              if recent_swing_high > tp1:                                     │
│                  tp2 = min(tp2_struct, recent_swing_high)                    │
│              else:                                                           │
│                  tp2 = tp2_struct                                            │
│                                                                              │
│              trade = {                                                       │
│                  "symbol": symbol,                                           │
│                  "entry_time": bar_time,                                     │
│                  "entry": entry,                                             │
│                  "sl": sl,                                                   │
│                  "initial_sl": sl,                                           │
│                  "tp1": tp1,                                                 │
│                  "tp2": tp2,                                                 │
│                  "swing_low": recent_swing_low,                              │
│                  "swing_high": recent_swing_high,                            │
│                  "initial_risk": risk,                                       │
│                  "remaining_size": 1.0,                                      │
│                  "realized_R": 0.0,                                          │
│                  "breakeven_moved": False,                                   │
│                  "scaled_out": False,                                        │
│                  "scale_price": None,                                        │
│                  "scale_time": None,                                         │
│                  "scale_reason": None,                                       │
│                  "exit_price": None,                                         │
│                  "exit_time": None,                                          │
│                  "exit_reason": None,                                        │
│                  "hold_bars": 0,                                             │
│                  "closed": False,                                            │
│                  "entry_index": i,                                           │
│              }                                                               │
│                                                                              │
│              # --- exit engine                                               │
│  ---------------------------------------------                               │
│              j = i + 1                                                       │
│              while j < n and not trade["closed"]:                            │
│                  bar = df.iloc[j]                                            │
│                  bar_ts = df.index[j]                                        │
│                  o = float(bar["Open"])                                      │
│                  h = float(bar["High"])                                      │
│                  lo_ = float(bar["Low"])                                     │
│                  c = float(bar["Close"])                                     │
│                  atr_j = float(bar["ATR"]) if np.isfinite(bar["ATR"]) else   │
│  atr                                                                         │
│                  cur_sl = trade["sl"]                                        │
│                                                                              │
│                  trade["hold_bars"] += 1                                     │
│                                                                              │
│                  # Time stop                                                 │
│                  if trade["hold_bars"] > MAX_HOLD_BARS:                      │
│                      _close_remainder(trade, c, bar_ts, "TIME_STOP")         │
│                      break                                                   │
│                                                                              │
│                  # 1) Gap checks take precedence (flaw G).                   │
│                  if o <= cur_sl:                                             │
│                      _close_remainder(trade, o, bar_ts, "GAP_STOP")          │
│                      break                                                   │
│                  if o >= trade["tp2"]:                                       │
│                      _close_remainder(trade, o, bar_ts, "GAP_TP2")           │
│                      break                                                   │
│                  if o >= trade["tp1"] and not trade["scaled_out"]:           │
│                      _scale_out(trade, o, bar_ts, "GAP_TP1")                 │
│                      if BREAKEVEN_AT_TP1:                                    │
│                          trade["sl"] = max(trade["sl"], trade["entry"])      │
│                          trade["breakeven_moved"] = True                     │
│                      trade["sl"] = max(trade["sl"], h - TRAIL_ATR_MULT *     │
│  atr_j)                                                                      │
│                      j += 1                                                  │
│                      continue                                                │
│                                                                              │
│                  # 2) Intrabar, PESSIMISTIC SL-FIRST ordering (flaws B/F).   │
│                  if lo_ <= cur_sl:                                           │
