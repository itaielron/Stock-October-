        if direction == "long":
            momentum_ok = (
                (close >= ema21)
                or (close > prev_close)
                or (close >= low + 0.5 * bar_range)
            )
        else:
            momentum_ok = (
                (close <= ema21)
                or (close < prev_close)
                or (close <= low + 0.5 * bar_range)
            )
        if not momentum_ok:
            return None

    # --- structural stop / targets ---------------------------------------
    if direction == "long":
        sl = near_swing_low - (SL_BUFFER_ATR * atr) - TICK
        if sl >= close:
            return None
        risk = close - sl
        if risk < MIN_RISK_ATR * atr:
            return None
        if risk > 3.0 * atr:
            return None
        tp1 = close + TP1_R * risk
        tp2_struct = close + TP2_R * risk
        tp2 = min(tp2_struct, recent_swing_high) if recent_swing_high > tp1 else tp2_struct
        if tp1 <= close:
            return None
    else:
        sl = near_swing_high + (SL_BUFFER_ATR * atr) + TICK
        if sl <= close:
            return None
        risk = sl - close
        if risk < MIN_RISK_ATR * atr:
