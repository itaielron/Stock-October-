    ema50_slope_up = False
    ema50_slope_dn = False
    if i >= 6:
        try:
            ema50_prev6 = float(df["EMA_50"].iloc[i - 6])
            if ema50_prev6 == ema50_prev6 and ema50_prev6 > 0:
                ema50_slope_up = ema50 > ema50_prev6
                ema50_slope_dn = ema50 < ema50_prev6
