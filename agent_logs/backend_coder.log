        regime == "trend"
        and abs(close - ema21) <= 0.5 * atr
        and close >= ema21 - 0.15 * atr
        and (close >= prev_close or prev_close >= prev_ema21)
    )
    pullback_short = (
        regime == "trend"
        and abs(close - ema21) <= 0.5 * atr
        and close <= ema21 + 0.15 * atr
        and (close <= prev_close or prev_close <= prev_ema21)
    )

    if direction == "long":
        if not (breakout_up or at_support or pullback_long):
