        else:
            momentum_ok = (
                (close <= ema21)
                or (close < prev_close)
                or (close <= low + 0.5 * bar_range)
            )
        if not momentum_ok:
            return None

    # --- structural stop / targets ---------------------------------------
    if direction == "long":
        sl = near_swing_low - (SL_BUFFER_ATR * atr) - TICK
