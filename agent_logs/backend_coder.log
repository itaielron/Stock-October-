    prev_close = float(prev["Close"])
    prev_high = float(prev["High"])
    prev_low = float(prev["Low"])
    prev_ema9 = float(prev["EMA9"]) if np.isfinite(prev["EMA9"]) else ema9
    prev_ema21 = float(prev["EMA21"]) if np.isfinite(prev["EMA21"]) else ema21

