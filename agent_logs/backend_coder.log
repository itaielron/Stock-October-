        _GATE_TRACE["chop_ok"] += 1

    # ============================================================
    # 6) STRUCTURAL PULLBACK + MOMENTUM + VOLUME + BREAKOUT (15Min tuned)
    # ============================================================
    swing_low = float(df["Low"].iloc[max(0, i - 16):i].min())
    swing_high = float(df["High"].iloc[max(0, i - 16):i].max())

    body = close - open_
    # 15Min: require a decisive body (>= 0.55 ATR) to filter micro-chop.
    min_body = atr14 * 0.55
    bullish_bar = body > min_body and close > prev_close
    bearish_bar = body < -min_body and close < prev_close

    # 15Min-specific: close must sit in the top/bottom 35% of the bar
    # range for trend entries (rejects wick-heavy indecision bars).
    if bar_range > 0:
        close_pos = (close - low) / bar_range
    else:
        close_pos = 0.5
    strong_close_up = close_pos >= 0.65
    strong_close_dn = close_pos <= 0.35

    # 15Min-specific: prior bar must confirm direction.
    prev_body = prev_close - prev_open
    prev_bullish = prev_body > 0
    prev_bearish = prev_body < 0

    # 15Min-specific: fresh breakout of the recent 2-bar extreme.
    recent2_high = float(df["High"].iloc[max(0, i - 2):i].max())
    recent2_low = float(df["Low"].iloc[max(0, i - 2):i].min())
    breakout_up = close > recent2_high
    breakout_dn = close < recent2_low

    # Volume confirmation: current bar volume >= 1.10x rolling mean (16 bars).
    vol_ok = True
    try:
        vol_mean = float(df["Volume"].iloc[max(0, i - 16):i].astype(float).mean())
        if vol_mean > 0:
            vol_ok = vol >= (vol_mean * 1.10)
    except (TypeError, ValueError):
        vol_ok = True

    # ============================================================
    # REGIME ROUTER (Mandate §1 + QA gate #1)
    #   negative -> trend-following
    #   positive -> mean-reversion
    #   neutral  -> permissive: BOTH sub-routines enabled
    # ============================================================
    block_mr_short = gex_proxy > 0.15
    block_mr_long = gex_proxy < -0.15

    # QA fix #3: SL floor is 1.5 * ATR. Risk ceiling is 3.0 * ATR.
    SL_FLOOR_ATR = 1.5
    SL_CEIL_ATR = 3.0

    def _trend_long():
        if not htf_long_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if not strong_close_up:
            return _rej("structure")
        if not breakout_up:
            return _rej("structure")
        if not confirm_long:
            return _rej("confirm")
        recent_low = float(df["Low"].iloc[i - 8:i].min())
        # 15Min: allow pullback within 0.50 ATR of EMA_21.
        pulled_back = recent_low <= ema_slow + (atr14 * 0.50)
        if not pulled_back:
            return _rej("structure")
        # 15Min-specific: prior bar must not be a strong counter-trend bar.
        if prev_bearish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = min(swing_low, recent_low) - (atr14 * SL_FLOOR_ATR)
        risk = entry - sl
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.0), "tp2": entry + (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_long",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_long_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _trend_short():
        if not htf_short_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if not strong_close_dn:
            return _rej("structure")
        if not breakout_dn:
            return _rej("structure")
        if not confirm_short:
            return _rej("confirm")
        recent_high = float(df["High"].iloc[i - 8:i].max())
        pulled_back = recent_high >= ema_slow - (atr14 * 0.50)
        if not pulled_back:
            return _rej("structure")
        if prev_bullish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = max(swing_high, recent_high) + (atr14 * SL_FLOOR_ATR)
        risk = sl - entry
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 2.0), "tp2": entry - (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_short",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_short_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _mr_long():
        if block_mr_long:
            return _rej("gex")
        if not htf_long_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if close >= ema_slow:
            return _rej("structure")
        if not bullish_bar:
            return _rej("structure")
        if not confirm_long:
            return _rej("confirm")
        dist_to_low = (close - swing_low) / atr14
        if dist_to_low > 1.2:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = swing_low - (atr14 * SL_FLOOR_ATR)
        risk = entry - sl
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.0), "tp2": entry + (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_long",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_long_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _mr_short():
        if block_mr_short:
            return _rej("gex")
        if not htf_short_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if close <= ema_slow:
            return _rej("structure")
        if not bearish_bar:
            return _rej("structure")
        if not confirm_short:
            return _rej("confirm")
        dist_to_high = (swing_high - close) / atr14
        if dist_to_high > 1.2:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = swing_high + (atr14 * SL_FLOOR_ATR)
        risk = sl - entry
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 2.0), "tp2": entry - (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_short",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_short_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _accept(sig):
        _REJECT_STATS["accepted"] += 1
        _GATE_TRACE["risk_ok"] += 1
        _GATE_TRACE["score_ok"] += 1
        _GATE_TRACE["all_ok"] += 1
        return sig

    # ============================================================
    # WEIGHTED CONFLUENCE SCORE (QA structural fix)
    #   EMA=2, ATR=1, GEX=1, HTF=1, VOL=1, STRUCT=1, CONFIRM=1
    #   Fire at >= 5/7. A single missing feed can no longer zero the
    #   system. Mandate §11 compliant.
    # ============================================================
    struct_ok = bool(
        (bullish_bar and strong_close_up and breakout_up)
        or (bearish_bar and strong_close_dn and breakout_dn)
    )

    score = 0
    score += 2 if ema_ok else 0
    score += 1 if atr_ok else 0
    score += 1 if htf_ok else 0
    score += 1 if vol_ok else 0
    score += 1 if struct_ok else 0
    score += 1 if confirm_ok else 0
    # GEX is always permissive (neutral default) — always contributes 1.
    score += 1

    if score < 5:
        return _rej("score")

    # Hard safety gates that must ALWAYS hold (never bypassed by score):
    if not entry_quality_ok:
        return _rej("entry_quality")
    if not chop_ok:
        return _rej("chop")
    if not (long_trend or short_trend):
        return _rej("ema")

    # ---- Regime routing (soft preference, never hard block) ----
    if gex_regime == "negative":
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        return _rej("structure")

    if gex_regime == "positive":
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        return _rej("structure")

    # ---- NEUTRAL: permissive — BOTH sub-routines enabled ----
    if vol_expansion:
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
    else:
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)

    return _rej("structure")
