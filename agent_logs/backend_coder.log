        if block_mr_short:
            return _rej("gex")
        if not htf_short_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if close <= ema_slow:
            return _rej("structure")
        if not bearish_bar:
            return _rej("structure")
        if not confirm_short:
            return _rej("confirm")
        dist_to_high = (swing_high - close) / atr14
        if dist_to_high > 1.2:
            return _rej("structure")
        entry = close
        sl = swing_high + (atr14 * 1.5)
        risk = sl - entry
        if risk <= 0 or risk < atr14 * 0.5 or risk > atr14 * 3.0:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 1.8), "tp2": entry - (risk * 3.0),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_short", "gex_proxy": gex_proxy,
            "htf_confirm": htf_short_confirm,
        }

    def _accept(sig):
        _REJECT_STATS["accepted"] += 1
        _GATE_TRACE["risk_ok"] += 1
        _GATE_TRACE["htf_ok"] += 1
        _GATE_TRACE["all_ok"] += 1
        return sig

    # ---- Regime routing (soft preference, never hard block) ----
    if gex_regime == "negative":
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        return _rej("structure")

    if gex_regime == "positive":
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        return _rej("structure")

    # ---- NEUTRAL: permissive — BOTH sub-routines enabled ----
    if vol_expansion:
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
    else:
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)

    if not (long_trend or short_trend):
        return _rej("ema")
    return _rej("structure")
