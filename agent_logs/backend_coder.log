    def _trend_short():
        if not htf_short_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if not strong_close_dn:
            return _rej("structure")
        if not breakout_dn:
            return _rej("structure")
        if not confirm_short:
            return _rej("confirm")
        recent_high = float(df["High"].iloc[i - 6:i].max())
        pulled_back = recent_high >= ema_slow - (atr14 * 0.75)
