    macro_blocks_long = macro_score <= -BULLISH_THRESHOLD
    macro_blocks_short = macro_score >= BULLISH_THRESHOLD

    # --- structure: swing levels -----------------------------------------
    win_lo = max(0, i - LOOKBACK)
