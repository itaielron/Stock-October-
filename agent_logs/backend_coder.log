        mtf_short_ok = (mtf_short_votes > mtf_long_votes) and (mtf_short_votes >= 2)
    elif mtf_available == 3:
        mtf_long_ok = (mtf_long_votes >= 2) and (ema_slope >= 0.30 * atr)
        mtf_short_ok = (mtf_short_votes >= 2) and (ema_slope <= -0.30 * atr)
    else:
