        if risk > 3.0 * atr:
            return None
        tp1 = close - TP1_R * risk
        tp2_struct = close - TP2_R * risk
        tp2 = max(tp2_struct, recent_swing_low) if recent_swing_low < tp1 else tp2_struct
        if tp1 >= close:
            return None

    return {
        "entry": close,
        "sl": sl,
        "tp1": tp1,
        "tp2": tp2,
        "swing_low": recent_swing_low,
        "swing_high": recent_swing_high,
