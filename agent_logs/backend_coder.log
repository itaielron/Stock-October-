        if not confirm_long:
            return _rej("confirm")
        recent_low = float(df["Low"].iloc[i - 10:i].min())
        # 5Min: allow pullback within 0.40 ATR of EMA_21.
        pulled_back = recent_low <= ema_slow + (atr14 * 0.40)
        if not pulled_back:
            return _rej("structure")
        # 5Min-specific: prior bar must not be a strong counter-trend bar.
        if prev_bearish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = min(swing_low, recent_low) - (atr14 * SL_FLOOR_ATR)
        risk = entry - sl
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.0), "tp2": entry + (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_long",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_long_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _trend_short():
        if not htf_short_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if not strong_close_dn:
            return _rej("structure")
        if not breakout_dn:
            return _rej("structure")
        if not confirm_short:
            return _rej("confirm")
        recent_high = float(df["High"].iloc[i - 10:i].max())
        pulled_back = recent_high >= ema_slow - (atr14 * 0.40)
        if not pulled_back:
            return _rej("structure")
        if prev_bullish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = max(swing_high, recent_high) + (atr14 * SL_FLOOR_ATR)
        risk = sl - entry
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 2.0), "tp2": entry - (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_short",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_short_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _mr_long():
        if block_mr_long:
            return _rej("gex")
        if not htf_long_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if close >= ema_slow:
            return _rej("structure")
        if not bullish_bar:
            return _rej("structure")
        if not confirm_long:
            return _rej("confirm")
        dist_to_low = (close - swing_low) / atr14
        if dist_to_low > 1.0:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = swing_low - (atr14 * SL_FLOOR_ATR)
        risk = entry - sl
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.0), "tp2": entry + (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_long",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_long_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _mr_short():
        if block_mr_short:
            return _rej("gex")
        if not htf_short_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if close <= ema_slow:
            return _rej("structure")
        if not bearish_bar:
            return _rej("structure")
        if not confirm_short:
            return _rej("confirm")
        dist_to_high = (swing_high - close) / atr14
        if dist_to_high > 1.0:
            return _rej("structure")
        entry = close
        # QA fix #3: SL floor at 1.5 * ATR.
        sl = swing_high + (atr14 * SL_FLOOR_ATR)
        risk = sl - entry
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 2.0), "tp2": entry - (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_short",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_short_confirm,
            "warmup_fallback": warmup_fallback,
        }

    def _accept(sig):
        _REJECT_STATS["accepted"] += 1
        _GATE_TRACE["risk_ok"] += 1
        _GATE_TRACE["htf_ok"] += 1
        _GATE_TRACE["all_ok"] += 1
        return sig

    # ---- Regime routing (soft preference, never hard block) ----
    if gex_regime == "negative":
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        return _rej("structure")

    if gex_regime == "positive":
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        return _rej("structure")

    # ---- NEUTRAL: permissive — BOTH sub-routines enabled ----
    if vol_expansion:
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
    else:
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)

    if not (long_trend or short_trend):
        return _rej("ema")
    return _rej("structure")
