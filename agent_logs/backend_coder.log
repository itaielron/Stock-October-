        if combined_against >= 7.0 * atr and close < prev_close - 0.60 * atr:
            return None
    else:
        combined_against = prev_move + prev2_move
        if combined_against >= 7.0 * atr and close > prev_close + 0.60 * atr:
            return None

    # --- structure confirmation ------------------------------------------
    breakout_up = close > recent_swing_high + BREAKOUT_BUFFER_ATR * atr
    breakout_dn = close < recent_swing_low - BREAKOUT_BUFFER_ATR * atr
    at_support = abs(close - recent_swing_low) <= SUPPORT_PROXIMITY_ATR * atr
    at_resistance = abs(close - recent_swing_high) <= SUPPORT_PROXIMITY_ATR * atr
    # v20: pullback continuation accepts a close that holds on the trend
    # side of EMA21 (close >= ema21 - 0.60*ATR for long) even if the
    # entry bar closed slightly against the trend, provided the prior
    # bar was a directional close.
    pullback_long = (
        regime == "trend"
        and abs(close - ema21) <= 0.5 * atr
        and close >= ema21 - 0.60 * atr
        and (close >= prev_close or prev_close >= prev_ema21)
    )
    pullback_short = (
        regime == "trend"
        and abs(close - ema21) <= 0.5 * atr
        and close <= ema21 + 0.60 * atr
        and (close <= prev_close or prev_close <= prev_ema21)
    )

    if direction == "long":
        if not (breakout_up or at_support or pullback_long):
            return None
    else:
        if not (breakout_dn or at_resistance or pullback_short):
            return None

    # --- momentum confirmation (trend only; mean-rev already encoded) ----
    # v20: accept if close is on the trend side of EMA21 (structural) OR
    # close > prev_close OR close in the trend half of the bar range.
    # Removes the EMA9 dependency that was rejecting slow-trend entries.
    if regime == "trend":
        if direction == "long":
            momentum_ok = (
                (close >= ema21)
                or (close > prev_close)
                or (close >= low + 0.5 * bar_range)
            )
        else:
            momentum_ok = (
                (close <= ema21)
                or (close < prev_close)
                or (close <= low + 0.5 * bar_range)
            )
        if not momentum_ok:
            return None

    # --- structural stop / targets ---------------------------------------
    if direction == "long":
        sl = near_swing_low - (SL_BUFFER_ATR * atr) - TICK
        if sl >= close:
            return None
        risk = close - sl
        if risk < MIN_RISK_ATR * atr:
            return None
        if risk > 3.0 * atr:
            return None
