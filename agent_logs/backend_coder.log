    # 0) MACRO / EVENT PAUSE (fail-soft, NON-STICKY — QA fix #4)
    #    Default Trading_Enabled = True. No calendar feed -> never block.
    #    Any False bar is logged via the `macro` rejection counter.
    # ============================================================
    macro_ok = True
    if "Trading_Enabled" in df.columns:
        try:
            te = row["Trading_Enabled"]
            if te is not None and te == te:
                macro_ok = bool(te)
        except (TypeError, ValueError):
            macro_ok = True
    if not macro_ok:
        return _rej("macro")
    _GATE_TRACE["macro_ok"] += 1

    # ============================================================
    # 1) GEX PROXY (Mandate §11 — never halt on missing GEX)
    #    QA fix #2: proxy is derived from price/volume ONLY. Missing feed
    #    => proxy=0.0 => regime="neutral" => BOTH sub-routines enabled.
    #    NEVER a hard veto. Every signal carries gex_proxy + gex_regime.
    # ============================================================
    lookback = 8  # 4Hour: 8 bars ≈ 1.3 days of context
    if i < lookback:
        return _rej("warmup")
    window = df.iloc[i - lookback:i]
    if len(window) < lookback:
        return _rej("warmup")

    w_close = window["Close"].astype(float).values
    w_vol = window["Volume"].astype(float).values

    total_vol = float(w_vol.sum())
    gex_regime = "neutral"
    gex_proxy = 0.0
    vol_expansion = False
    vol_slope = 0.0

    if total_vol > 0:
        vwap = float((w_close * w_vol).sum() / total_vol)
        drift = (close - vwap) / vwap if vwap > 0 else 0.0

        rets = np.diff(w_close) / w_close[:-1]
        if len(rets) >= 4:
            recent_vol = float(np.std(rets[-2:])) + 1e-9
            prior_vol = float(np.std(rets[:-2])) + 1e-9
            vol_slope = (recent_vol - prior_vol) / prior_vol
            vol_expansion = vol_slope > 0.15
        else:
            vol_slope = 0.0

        # QA gate #1: directional proxy from EMA_21 vs EMA_50 (or EMA_9).
        ema_ref = ema50 if ema50 is not None else ema9
        ema_dir_sign = 0.0
        if ema_ref is not None and ema_ref > 0:
            if ema_slow > ema_ref:
                ema_dir_sign = 1.0
            elif ema_slow < ema_ref:
                ema_dir_sign = -1.0

        # Volume z-score over the lookback window.
        vol_mean = float(np.mean(w_vol)) + 1e-9
        vol_std = float(np.std(w_vol)) + 1e-9
        vol_z = (vol - vol_mean) / vol_std

        # Composite proxy: directional EMA sign * volume z-score,
        # blended with drift and vol slope for robustness.
        gex_proxy = (ema_dir_sign * vol_z * 0.5) + (drift * 0.4) + (vol_slope * 0.1)

        # Neutral band: near-zero proxy => neutral (permissive).
        if gex_proxy < -0.15:
            gex_regime = "negative"
        elif gex_proxy > 0.15:
            gex_regime = "positive"
        else:
            gex_regime = "neutral"

    # GEX gate is ALWAYS satisfied (neutral is permissive). Trace it.
    _GATE_TRACE["gex_ok"] += 1

    # ============================================================
    # 2) EMA TREND FILTER (state + slope, NO crossover event)
    #    4Hour: EMA_21 slope over 2 bars (≈8 hours).
    #    Longs: Close > EMA_21 AND EMA_21 slope > 0 AND
    #           (Close - EMA_21) >= 0.25 * ATR.
    #    Shorts: symmetric.
    # ============================================================
    ema_slope_up = False
    ema_slope_dn = False
    if i >= 2:
        try:
            ema_slow_prev2 = float(df["EMA_21"].iloc[i - 2]) if "EMA_21" in df.columns else None
            if ema_slow_prev2 is None or ema_slow_prev2 != ema_slow_prev2 or ema_slow_prev2 <= 0:
                if "EMA_50" in df.columns:
                    ema_slow_prev2 = float(df["EMA_50"].iloc[i - 2])
            if ema_slow_prev2 is not None and ema_slow_prev2 == ema_slow_prev2 and ema_slow_prev2 > 0:
                ema_slope_up = ema_slow > ema_slow_prev2
                ema_slope_dn = ema_slow < ema_slow_prev2
        except (TypeError, ValueError):
            pass

    dist_from_ema = close - ema_slow
    long_trend = (
        close > ema_slow
        and ema_slope_up
        and dist_from_ema >= (atr14 * 0.25)
    )
    short_trend = (
        close < ema_slow
        and ema_slope_dn
        and (-dist_from_ema) >= (atr14 * 0.25)
    )

    ema_ok = bool(long_trend or short_trend)
    if ema_ok:
        _GATE_TRACE["ema_ok"] += 1

    # ============================================================
    # 3) ATR SANITY BAND — PERCENTILE-RELATIVE (QA fix #3)
    #    Compute trailing 20th–90th percentile of ATR/Close over the
    #    last 100 bars. This adapts to the symbol's own volatility
    #    regime and never rejects every bar on a quiet tape.
    # ============================================================
    atr_pct = atr14 / close
    atr_ok = True
    try:
        hist_start = max(0, i - 100)
        hist_atr = df["ATR_14"].iloc[hist_start:i].astype(float).values
        hist_close = df["Close"].iloc[hist_start:i].astype(float).values
        if len(hist_atr) >= 20:
            with np.errstate(divide="ignore", invalid="ignore"):
                hist_pct = hist_atr / hist_close
            hist_pct = hist_pct[np.isfinite(hist_pct)]
            if len(hist_pct) >= 20:
                lo = float(np.percentile(hist_pct, 20))
                hi = float(np.percentile(hist_pct, 90))
                # Widen slightly to avoid edge-rejection on regime shifts.
                lo = lo * 0.5
                hi = hi * 1.5
                atr_ok = (atr_pct >= lo) and (atr_pct <= hi)
    except (TypeError, ValueError, KeyError):
        atr_ok = True

    if atr_ok:
        _GATE_TRACE["atr_ok"] += 1

    # ============================================================
    # 4) HTF ANCHOR (MTFA, Mandate §5)
    #    Prefer 4H EMA if present; else EMA_200 (if warmup OK); else
    #    EMA_50 vs EMA_21 stack (warmup fallback).
    # ============================================================
    htf_long_confirm = False
    htf_short_confirm = False
    if htf_ema is not None:
        htf_long_confirm = close > htf_ema
        htf_short_confirm = close < htf_ema
    elif ema50 is not None and ema21 is not None:
        htf_long_confirm = ema21 > ema50
        htf_short_confirm = ema21 < ema50
    elif ema21 is not None and ema9 is not None:
        htf_long_confirm = ema21 > ema9
        htf_short_confirm = ema21 < ema9
    else:
        htf_long_confirm = True
        htf_short_confirm = True

    htf_ok = bool(htf_long_confirm or htf_short_confirm)
    if htf_ok:
        _GATE_TRACE["htf_ok"] += 1

    # ============================================================
    # 5) ENTRY CONFIRMATION (QA gate #2)
    #    Long: Close[t] > High[t-1].  Short: Close[t] < Low[t-1].
    # ============================================================
    confirm_long = close > prev_high
    confirm_short = close < prev_low
    confirm_ok = bool(confirm_long or confirm_short)
    if confirm_ok:
        _GATE_TRACE["confirm_ok"] += 1

    # ============================================================
    # 5b) ENTRY-QUALITY GATE (QA fix #2)
    #     Reject if entry candle range < 0.50 * ATR. Kills doji/indecision
    #     entries that produced the immediate stop-out loser.
    # ============================================================
    bar_range = high - low
    entry_quality_ok = bar_range >= (atr14 * 0.50)
    if entry_quality_ok:
        _GATE_TRACE["entry_quality_ok"] += 1

    # ============================================================
    # 5c) CHOP FILTER (4Hour-specific)
    #     Reject if the last 3 bars are inside a tight range
    #     (< 1.0 ATR total) — that is chop, not a confluence cluster.
    # ============================================================
    chop_ok = True
    try:
        last3_high = float(df["High"].iloc[i - 3:i].max())
        last3_low = float(df["Low"].iloc[i - 3:i].min())
        if (last3_high - last3_low) < (atr14 * 1.0):
            chop_ok = False
    except (TypeError, ValueError):
        chop_ok = True
    if chop_ok:
        _GATE_TRACE["chop_ok"] += 1

    # ============================================================
    # 6) STRUCTURAL PULLBACK + MOMENTUM + VOLUME + BREAKOUT (4Hour tuned)
    # ============================================================
    swing_low = float(df["Low"].iloc[max(0, i - 8):i].min())
    swing_high = float(df["High"].iloc[max(0, i - 8):i].max())

    body = close - open_
    # 4Hour: require a decisive body (>= 0.55 ATR) to filter micro-chop.
    min_body = atr14 * 0.55
    bullish_bar = body > min_body and close > prev_close
    bearish_bar = body < -min_body and close < prev_close

    # 4Hour-specific: close must sit in the top/bottom 35% of the bar
    # range for trend entries (rejects wick-heavy indecision bars).
    if bar_range > 0:
        close_pos = (close - low) / bar_range
    else:
        close_pos = 0.5
    strong_close_up = close_pos >= 0.65
    strong_close_dn = close_pos <= 0.35

    # 4Hour-specific: prior bar must confirm direction.
    prev_body = prev_close - prev_open
    prev_bullish = prev_body > 0
    prev_bearish = prev_body < 0

    # 4Hour-specific: fresh breakout of the recent 2-bar extreme.
    recent2_high = float(df["High"].iloc[max(0, i - 2):i].max())
    recent2_low = float(df["Low"].iloc[max(0, i - 2):i].min())
    breakout_up = close > recent2_high
    breakout_dn = close < recent2_low

    # Volume confirmation: current bar volume >= 1.10x rolling mean (8 bars).
    vol_ok = True
    try:
        vol_mean = float(df["Volume"].iloc[max(0, i - 8):i].astype(float).mean())
        if vol_mean > 0:
            vol_ok = vol >= (vol_mean * 1.10)
    except (TypeError, ValueError):
        vol_ok = True

    # ============================================================
    # REGIME ROUTER (Mandate §1 + QA gate #1)
    #   negative -> trend-following
    #   positive -> mean-reversion
    #   neutral  -> permissive: BOTH sub-routines enabled
    # ============================================================
    block_mr_short = gex_proxy > 0.15
    block_mr_long = gex_proxy < -0.15

    # QA fix #5: SL is ALWAYS entry ± ATR14 × 1.5 (never a fixed tick).
    # Risk ceiling is 3.0 * ATR to prevent runaway stops.
    SL_FLOOR_ATR = 1.5
    SL_CEIL_ATR = 3.0

    def _trend_long():
        if not htf_long_confirm:
            return _rej("htf")
        if not vol_ok:
            return _rej("volume")
        if not strong_close_up:
            return _rej("structure")
        if not breakout_up:
            return _rej("structure")
        if not confirm_long:
            return _rej("confirm")
        recent_low = float(df["Low"].iloc[i - 6:i].min())
        # 4Hour: allow pullback within 0.75 ATR of EMA_21.
        pulled_back = recent_low <= ema_slow + (atr14 * 0.75)
        if not pulled_back:
            return _rej("structure")
        # 4Hour-specific: prior bar must not be a strong counter-trend bar.
        if prev_bearish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        # QA fix #5: SL is ALWAYS entry - ATR14 × 1.5 (never a fixed tick).
        sl = entry - (atr14 * SL_FLOOR_ATR)
        risk = entry - sl
        if risk <= 0 or risk < atr14 * SL_FLOOR_ATR or risk > atr14 * SL_CEIL_ATR:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.0), "tp2": entry + (risk * 3.5),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_long",
            "gex_proxy": gex_proxy, "gex_regime": gex_regime,
            "atr_entry": atr14,
            "htf_confirm": htf_long_confirm,
            "warmup_fallback": warmup_fallback,
            "entry_bar_index": i,
