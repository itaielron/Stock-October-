    near_lo = max(0, i - NEAR_SWING_LOOKBACK)
    near_swing_low = float(df["Low"].iloc[near_lo:i].min())
    near_swing_high = float(df["High"].iloc[near_lo:i].max())

    # --- direction selection ---------------------------------------------
    direction = None
    setup_type = None

    if regime == "trend":
