    for col in ("EMA9", "EMA21", "Close", "High", "Low"):
        if col not in df.columns:
            return None

    ema9 = float(row["EMA9"])
    ema21 = float(row["EMA21"])
    close = float(row["Close"])
    high = float(row["High"])
    low = float(row["Low"])
