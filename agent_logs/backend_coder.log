    sl = min(structural_sl, atr_sl, pct_floor_sl)
    if sl >= close:
        return None

    risk = close - sl

    # --- 11. MINIMUM RISK GATE -------------------------------------------
    if risk < MIN_RISK_ATR * atr:
        return None

    # --- 12. TP1 must clear 1.0*ATR (1Min: smallest of all TFs) ----------
    tp1 = close + TP1_R * risk
    if (tp1 - close) < 1.0 * atr:
        return None

    # --- structural targets ----------------------------------------------
    tp2_struct = close + TP2_R * risk
    if recent_swing_high > tp1:
        tp2 = min(tp2_struct, recent_swing_high)
    else:
        tp2 = tp2_struct

    _FUNNEL["signals"] += 1

    return {
        "entry": close,
        "sl": sl,
        "tp1": tp1,
        "tp2": tp2,
        "swing_low": recent_swing_low,
        "swing_high": recent_swing_high,
        "risk": risk,
        "breakout": breakout,
        "at_support": at_support,
        "fresh_cross": fresh_cross,
        "reclaim": reclaim,
        "atr": atr,
        "adx": adx,
        "atr_mean": atr_mean,
        "ema200_bonus": ema200_bonus,
        "timeframe": "1Min",
    }
