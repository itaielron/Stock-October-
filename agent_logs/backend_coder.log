        # to 0.02*ATR (was 0.03); hard veto kept at 3.0*ATR. Reclaim/wick
        # logic broadened to include outer-55% close in fade direction.
        if ema50 is not None:
            stretch = (close - ema50) / atr
            reclaim_up = close > prev_close
