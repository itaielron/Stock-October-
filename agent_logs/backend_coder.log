            elif (ema9 < ema21 and short_bias and mtf_short_ok
                    and not macro_blocks_short and ema21_slope_ok_short):
                direction = "short"
                setup_type = "trend_follow_short"
    else:
        # Mean reversion: fade exhaustion. v13: stretch threshold relaxed
