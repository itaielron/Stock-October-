    try:
        vol_mean = float(df["Volume"].iloc[max(0, i - 24):i].astype(float).mean())
        if vol_mean > 0:
            vol_ok = vol >= (vol_mean * 1.15)
    except (TypeError, ValueError):
        vol_ok = True

