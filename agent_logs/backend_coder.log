        combined_against = -(prev_move + prev2_move)
        if combined_against >= 5.5 * atr and close < prev_close - 0.35 * atr:
            return None
    else:
        combined_against = prev_move + prev2_move
        if combined_against >= 5.5 * atr and close > prev_close + 0.35 * atr:
            return None

