        pulled_back = recent_low <= ema50 + (atr14 * 0.8)
        if not pulled_back:
            return _rej("structure")
        # 1H continuation: EMA_50 must be rising (or flat-but-not-falling).
        if not ema50_slope_up and ema50_slope_dn:
            return _rej("structure")
        # 1H-specific: prior bar must not be a strong counter-trend bar.
        if prev_bearish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        sl = min(swing_low, recent_low) - (atr14 * 1.5)
        risk = entry - sl
        if risk <= 0 or risk > atr14 * 3.0:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.2), "tp2": entry + (risk * 4.0),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_long", "gex_proxy": gex_proxy,
        }

    def _trend_short():
        if not vol_ok:
            return _rej("volume")
        recent_high = float(df["High"].iloc[i - 8:i].max())
        pulled_back = recent_high >= ema50 - (atr14 * 0.8)
        if not pulled_back:
            return _rej("structure")
        if not ema50_slope_dn and ema50_slope_up:
            return _rej("structure")
        # 1H-specific: prior bar must not be a strong counter-trend bar.
        if prev_bullish and abs(prev_body) > atr14 * 0.5:
            return _rej("structure")
        entry = close
        sl = max(swing_high, recent_high) + (atr14 * 1.5)
        risk = sl - entry
        if risk <= 0 or risk > atr14 * 3.0:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 2.2), "tp2": entry - (risk * 4.0),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "trend_short", "gex_proxy": gex_proxy,
        }

    def _mr_long():
        if not vol_ok:
            return _rej("volume")
        # 1H mean-reversion: require close below EMA_50 (stretched down).
        if close >= ema50:
            return _rej("structure")
        if not bullish_bar:
            return _rej("structure")
        dist_to_low = (close - swing_low) / atr14
        if dist_to_low > 1.5:
            return _rej("structure")
        entry = close
        sl = swing_low - (atr14 * 1.5)
        risk = entry - sl
        if risk <= 0 or risk > atr14 * 3.0:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry + (risk * 2.2), "tp2": entry + (risk * 4.0),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_long", "gex_proxy": gex_proxy,
        }

    def _mr_short():
        if not vol_ok:
            return _rej("volume")
        if close <= ema50:
            return _rej("structure")
        if not bearish_bar:
            return _rej("structure")
        dist_to_high = (swing_high - close) / atr14
        if dist_to_high > 1.5:
            return _rej("structure")
        entry = close
        sl = swing_high + (atr14 * 1.5)
        risk = sl - entry
        if risk <= 0 or risk > atr14 * 3.0:
            return _rej("risk")
        return {
            "entry": entry, "sl": sl,
            "tp1": entry - (risk * 2.2), "tp2": entry - (risk * 4.0),
            "swing_low": swing_low, "swing_high": swing_high,
            "risk": risk, "regime": "mr_short", "gex_proxy": gex_proxy,
        }

    def _accept(sig):
        _REJECT_STATS["accepted"] += 1
        _GATE_TRACE["risk_ok"] += 1
        _GATE_TRACE["all_ok"] += 1
        return sig

    # ---- Regime routing ----
    if gex_regime == "negative":
        # Trend-following regime
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        return _rej("gex")

    if gex_regime == "positive":
        # Mean-reversion regime
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        return _rej("gex")

    # ---- NEUTRAL: permissive — BOTH sub-routines enabled (QA fix #4) ----
    # Route by realized-vol expansion (ADX-style proxy): expanding vol =>
    # trend-following; contracting vol => mean-reversion. This gives the
    # neutral regime a structural bias instead of blind "try everything".
    if vol_expansion:
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)
        # Fall through to mean-reversion if trend structure not present.
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
    else:
        # Contracting vol => mean-reversion first, then trend fallback.
        sig = _mr_long()
        if sig:
            return _accept(sig)
        sig = _mr_short()
        if sig:
            return _accept(sig)
        if long_trend and bullish_bar:
            sig = _trend_long()
            if sig:
                return _accept(sig)
        if short_trend and bearish_bar:
            sig = _trend_short()
            if sig:
                return _accept(sig)

    # Neutral regime exhausted both sub-routines — classify by dominant gate.
    if not (long_trend or short_trend):
        return _rej("ema")
    return _rej("structure")
