            reclaim_up = close > prev_close
            reclaim_dn = close < prev_close
            wick_up = low < min(prev_low, float(prev2["Low"]))
            wick_dn = high > max(prev_high, float(prev2["High"]))
            # v20: outer-75% close in fade direction.
            close_upper = close >= low + 0.25 * bar_range
            close_lower = close <= low + 0.75 * bar_range

            if abs(stretch) <= 3.0:
                if stretch <= -0.06 and (reclaim_up or wick_up or close_upper) and mtf_long_ok and not macro_blocks_long:
                    direction = "long"
                    setup_type = "mean_revert_long"
                elif stretch >= 0.06 and (reclaim_dn or wick_dn or close_lower) and mtf_short_ok and not macro_blocks_short:
                    direction = "short"
                    setup_type = "mean_revert_short"

    if direction is None:
        return None

    # --- distance gate (don't chase) -------------------------------------
    if abs(close - ema21) > DISTANCE_GATE_ATR * atr:
        return None
    if (close - ema21) > 2.0 * atr and direction == "long":
        return None
    if (ema21 - close) > 2.0 * atr and direction == "short":
        return None

    # --- anti-chase gate (losers were late entries) ----------------------
    move_3 = close - float(prev3["Close"])
    if direction == "long" and move_3 > 3.5 * atr:
        return None
    if direction == "short" and -move_3 > 3.5 * atr:
        return None

    # --- composite reversal veto (v20 relaxed) ---------------------------
    # Require combined against move >= 7.0*ATR (was 6.5) AND the current
    # bar fails to reclaim the prior bar's close by more than 0.60*ATR.
