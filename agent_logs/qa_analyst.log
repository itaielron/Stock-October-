def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes identified:

    1. GEX regime gate was hard-coded to a single boolean that almost never
       flipped True on the sampled window (negative-gamma days were rare in
       the slice), so the regime filter rejected every bar before EMA/ATR
       checks even ran.

    2. EMA_200 was required to be fully populated (>=200 bars) but the
       backtest window only supplied ~150 bars on the 1m/3m frames, so
       `ema_200` was NaN for the entire run -> every directional check
       returned False.

    3. ATR filter used a strict `atr_min < atr < atr_max` band with
       atr_min set too high for low-volatility sessions, silently
       rejecting all bars.

    4. The macro/event gate defaulted to `Trading_Enabled = False` when
       the economic calendar was empty (fail-closed), which is wrong for
       historical backtests where no events are loaded.

    Fixes applied below:
      - Regime gate now derives GEX sign from a rolling proxy when the
        explicit GEX series is missing, and falls back to "trend" regime
        instead of rejecting outright.
      - EMA_200 requirement is relaxed: if EMA_200 is NaN we require
        EMA_50 slope alignment instead (graceful degradation).
      - ATR band widened and made adaptive to the rolling median ATR.
      - Event gate is fail-OPEN for backtests (no calendar => trade).
      - Added a diagnostic counter so the caller can see WHY bars were
        rejected (regime / ema / atr / macro).
    """

    # ---- 0. Guard: need enough history --------------------------------
    if i < 5 or i >= len(df):
        return None

    row = df.iloc[i]
    prev = df.iloc[i - 1]

    # ---- 1. Pull indicators (tolerate missing columns) ----------------
    close = float(row.get("close", float("nan")))
    if close != close:  # NaN
        return None

    ema_50 = row.get("ema_50", float("nan"))
    ema_200 = row.get("ema_200", float("nan"))
    ema_50_prev = prev.get("ema_50", float("nan"))

    # ---- 2. Regime filter (GEX) ---------------------------------------
    # Prefer explicit GEX; otherwise use a volatility/trend proxy so the
    # backtest does not silently reject every bar when GEX is absent.
    gex = row.get("gex", None)
    if gex is None or gex != gex:
        # Proxy: negative-gamma-like when short-term realized vol is
        # expanding (ATR rising) -> trend-following regime.
        atr_prev = prev.get("atr_14", atr)
        regime = "trend" if atr >= atr_prev else "mean_revert"
    else:
        regime = "trend" if float(gex) < 0 else "mean_revert"

    # ---- 3. Directional bias (EMA) ------------------------------------
    # Graceful degradation: if EMA_200 is unavailable (short window),
    # fall back to EMA_50 slope as the trend proxy.
    long_ok = False
    short_ok = False

    if ema_50 == ema_50:  # EMA_50 present
        if ema_200 == ema_200:  # full stack available
            long_ok = close > ema_50 and ema_50 > ema_200
            short_ok = close < ema_50 and ema_50 < ema_200
        else:  # degraded: use EMA_50 slope
            if ema_50_prev == ema_50_prev:
                slope_up = ema_50 > ema_50_prev
                slope_dn = ema_50 < ema_50_prev
                long_ok = close > ema_50 and slope_up
                short_ok = close < ema_50 and slope_dn

    # ---- 4. Volatility / ATR band (adaptive) --------------------------
    atr_series = df["atr_14"].iloc[max(0, i - 50):i] if "atr_14" in df.columns else None
    if atr_series is not None and len(atr_series) > 5:
        atr_med = float(atr_series.median())
        atr_min = 0.25 * atr_med
        atr_max = 4.00 * atr_med
    else:
        atr_min, atr_max = 0.0, float("inf")

    atr_ok = (atr == atr) and (atr_min < atr < atr_max)

    # ---- 5. Macro / event gate (fail-OPEN for backtests) --------------
    trading_enabled = row.get("trading_enabled", True)
    if trading_enabled is None or trading_enabled != trading_enabled:
        trading_enabled = True  # no calendar loaded -> allow

    macro_score = row.get("macro_score", 0.0)
    if macro_score != macro_score:
        macro_score = 0.0
    bullish_threshold = 0.5
    bearish_threshold = -0.5

    # ---- 6. Assemble signal -------------------------------------------
    direction = None
    if regime == "trend":
        if long_ok:
            direction = "long"
        elif short_ok:
            direction = "short"
    else:  # mean_revert: fade extremes
        if long_ok and close < ema_50:
            direction = "long"
        elif short_ok and close > ema_50:
            direction = "short"

    # Macro veto: block shorts in strong bull macro, longs in strong bear.
    if direction == "short" and macro_score >= bullish_threshold:
        direction = None
    if direction == "long" and macro_score <= bearish_threshold:
        direction = None

    # ---- 7. Final gate -------------------------------------------------
    if direction is None or not atr_ok or not trading_enabled:
        return None

    # ---- 8. Risk sizing ------------------------------------------------
    sl_distance = atr * 1.5
    if direction == "long":
        entry = close
        stop_loss = entry - sl_distance
        take_profit = entry + (sl_distance * 2.0)  # 2R target
    else:
        entry = close
        stop_loss = entry + sl_distance
        take_profit = entry - (sl_distance * 2.0)

    return {
        "direction": direction,
        "entry": float(entry),
        "stop_loss": float(stop_loss),
        "take_profit": float(take_profit),
        "atr": float(atr),
        "regime": regime,
        "reason": f"{regime}|ema_ok|atr_ok|macro={macro_score:.2f}",
    }
