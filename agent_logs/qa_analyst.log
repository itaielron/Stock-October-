        sl = entry - sl_distance
        tp1 = entry + sl_distance * 1.0
        tp2 = entry + sl_distance * 2.0
    else:
        entry = close
        sl = entry + sl_distance
        tp1 = entry - sl_distance * 1.0
        tp2 = entry - sl_distance * 2.0

    return {
        "direction": direction,
        "entry": float(entry),
        "sl": float(sl),
        "tp1": float(tp1),
        "tp2": float(tp2),
