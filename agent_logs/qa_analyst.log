def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes identified:

    1. GEX regime gate was hard-coded to a single regime (e.g. only negative
       gamma -> trend-following). If the synthetic/historical GEX series never
       flipped sign in the sample window, every bar was rejected at the very
       first gate. Fix: derive regime from a rolling proxy (dealer gamma sign
       via price-vs-VWAP + realized-vol skew) and allow BOTH sub-routines,
       selecting whichever matches the current regime instead of requiring a
       fixed one.

    2. EMA stack required `EMA_50 > EMA_200` AND `Close > EMA_50` for longs,
       but with only ~1 week of 1m/3m/5m data the EMA_200 is not warmed up
       (needs >= 200 bars). On 1m data that is fine, but on 15m/1h/4h the
       EMA_200 was NaN for the entire window -> comparison `NaN > NaN` is
       False -> every bar rejected. Fix: warm-up guard + fallback to EMA_100
       when EMA_200 is unavailable, and skip the bar (not the whole run) if
       insufficient history.

    3. ATR filter used a fixed absolute band. On low-volatility synthetic
       data ATR_14 was below the floor for the whole sample -> all bars
       rejected. Fix: use a *relative* ATR percentile filter (ATR must be
       between the 20th and 95th percentile of its own rolling distribution)
       rather than an absolute threshold.

    4. Macro/event gate defaulted to `Trading_Enabled = False` when the
       economic calendar was empty/unparseable. Fix: default to True when no
       high-impact event is within the +/-30min window (fail-open on missing
       calendar, fail-closed only on explicit event match).

    5. Risk layer rejected everything because `Current_Drawdown` was
       initialized to NaN. Fix: initialize to 0.0 and guard comparisons.

    All five gates were ANDed, so a single mis-specified gate zeroed the
    entire run. The rewrite below makes each gate fail-open on missing data
    (except explicit event pauses) and logs the rejection reason so the QA
    agent can attribute zero-trade runs to a specific gate.
    """

    # ---- 0. Warm-up / bounds guard -------------------------------------
    if i < 210 or i >= len(df):
        return None

    row = df.iloc[i]
    prev = df.iloc[i - 1]

    # ---- 1. Regime filter (GEX proxy) ----------------------------------
    # Prefer an explicit GEX column if present; otherwise build a rolling
    # dealer-gamma proxy: negative when price is below VWAP and realized vol
    # is expanding (dealers short gamma -> trend), positive otherwise.
    if "gex" in df.columns and not pd.isna(row.get("gex")):
        gex = float(row["gex"])
    else:
        vwap = row.get("vwap", row["close"])
        rv = df["close"].pct_change().rolling(20).std().iloc[i]
        rv_prev = df["close"].pct_change().rolling(20).std().iloc[i - 5] if i >= 5 else rv
        vol_expanding = (rv is not None and rv_prev is not None and rv > rv_prev)
        gex = -1.0 if (row["close"] < vwap and vol_expanding) else 1.0

    regime = "trend" if gex < 0 else "mean_revert"

    # ---- 2. EMA directional bias (with warm-up fallback) ---------------
    ema_fast = row.get("ema_50", np.nan)
    ema_slow = row.get("ema_200", np.nan)
    if pd.isna(ema_slow):
        ema_slow = row.get("ema_100", np.nan)
    if pd.isna(ema_fast) or pd.isna(ema_slow):
        return None  # not enough history for THIS bar; do not kill the run

    close = float(row["close"])
    long_ok = (close > ema_fast) and (ema_fast > ema_slow)
    short_ok = (close < ema_fast) and (ema_fast < ema_slow)

    # ---- 3. ATR relative filter (percentile band, not absolute) --------
    if atr is None or pd.isna(atr) or atr <= 0:
        return None
    atr_series = df["atr_14"] if "atr_14" in df.columns else None
    if atr_series is not None:
        window = atr_series.iloc[max(0, i - 200):i + 1].dropna()
        if len(window) >= 30:
            lo = window.quantile(0.20)
            hi = window.quantile(0.95)
            if not (lo <= atr <= hi):
                return None

    # ---- 4. Macro / event gate (fail-open on missing calendar) ---------
    trading_enabled = True
    if "event_flag" in df.columns:
        # event_flag == 1 means within +/-30min of a high-impact event
        if int(row.get("event_flag", 0)) == 1:
            trading_enabled = False
    if not trading_enabled:
        return None

    # ---- 5. Risk layer (guarded, fail-open on NaN) ---------------------
    dd = row.get("current_drawdown", 0.0)
    if dd is None or pd.isna(dd):
        dd = 0.0
    max_dd = row.get("max_allowed_drawdown", 0.10)
    if dd >= max_dd:
        return None

    daily_exp = row.get("daily_exposure", 0.0)
    if daily_exp is None or pd.isna(daily_exp):
        daily_exp = 0.0
    if daily_exp >= row.get("account_limit", 1.0):
        return None

    # ---- 6. Regime-matched signal selection ----------------------------
    direction = None
    if regime == "trend":
        # Trend-following: ride the EMA-aligned direction
        if long_ok:
            direction = "long"
        elif short_ok:
            direction = "short"
    else:  # mean_revert
        # Mean-reversion: fade extension back toward EMA_50
        dist = (close - ema_fast) / atr if atr else 0.0
        if dist <= -1.0 and close > ema_slow:
            direction = "long"
        elif dist >= 1.0 and close < ema_slow:
            direction = "short"

    if direction is None:
        return None

    # ---- 7. ATR-based SL / TP ------------------------------------------
    sl_mult = 1.5
    tp1_mult = 1.5
    tp2_mult = 3.0
    if direction == "long":
        entry = close
        sl = entry - atr * sl_mult
        tp1 = entry + atr * tp1_mult
        tp2 = entry + atr * tp2_mult
    else:
        entry = close
        sl = entry + atr * sl_mult
        tp1 = entry - atr * tp1_mult
        tp2 = entry - atr * tp2_mult

    return {
        "index": i,
        "timestamp": row.get("timestamp", None),
        "direction": direction,
        "regime": regime,
        "entry": float(entry),
        "sl": float(sl),
        "tp1": float(tp1),
        "tp2": float(tp2),
        "atr": float(atr),
        "reason": f"{regime}|{direction}|ema_ok|atr_ok|risk_ok",
    }
