def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON ZERO-TRADE RUNS:
    ------------------------
    The previous run produced trades=0. Root causes (in order of likelihood):

      1. Warm-up starvation: EMA_200 requires >=200 bars. If the backtest
         window is short (e.g. one week of 1m bars = ~2000 bars is fine, but
         a 5m/15m/1h/4h slice of "past week" gives only 288/96/24/6 bars),
         EMA_200 is NaN for the entire 4h and 1h series -> every directional
         gate fails -> zero signals. Fix: fall back to EMA_50/EMA_20 slope
         when EMA_200 is unavailable, and require a minimum bar count.

      2. GEX regime never matched: if `gex` column is missing or all-zero,
         the regime filter rejects every bar. Fix: treat missing/zero GEX
         as NEUTRAL and allow trend-following only (conservative default),
         rather than rejecting outright.

      3. ATR band too tight: `atr_min`/`atr_max` percentile gates can
         exclude 100% of bars in low-vol regimes. Fix: widen to a soft
         penalty instead of a hard reject.

      4. Macro/event pause stuck True: if the event calendar flag was
         never reset, Trading_Enabled stayed False. Fix: default to True
         when the flag is absent.

    This rewrite makes each gate fail-soft (degrade, don't reject) so the
    engine always emits *some* candidate, letting the QA layer decide.
    """

    # ---- 0. Guard rails -------------------------------------------------
    if i < 2 or i >= len(df):
        return None

    row = df.iloc[i]
    prev = df.iloc[i - 1]

    # ---- 1. Macro / event gate (fail-soft) ------------------------------
    # If the column is absent, assume trading is enabled.
    if "trading_enabled" in df.columns and not bool(row.get("trading_enabled", True)):
        return None

    macro_score = float(row.get("macro_score", 0.0))
    BULLISH_THRESHOLD = 0.5
    BEARISH_THRESHOLD = -0.5

    # ---- 2. EMA trend (multi-timeframe, fail-soft on EMA_200) -----------
    close = float(row["close"])
    ema20 = row.get("ema_20", float("nan"))
    ema50 = row.get("ema_50", float("nan"))
    ema200 = row.get("ema_200", float("nan"))

    # Higher-timeframe EMAs (optional columns; NaN if not provided)
    ema50_htf = row.get("ema_50_htf", float("nan"))
    ema200_htf = row.get("ema_200_htf", float("nan"))

    import math

    def _ok(x):
        return x is not None and not (isinstance(x, float) and math.isnan(x))

    # Base trend: prefer full 50/200 stack, fall back to 20/50 slope.
    if _ok(ema50) and _ok(ema200):
        long_trend = close > ema50 and ema50 > ema200
        short_trend = close < ema50 and ema50 < ema200
    elif _ok(ema20) and _ok(ema50):
        long_trend = close > ema50 and ema20 > ema50
        short_trend = close < ema50 and ema20 < ema50
    else:
        # Not enough EMA data -> no directional edge.
        return None

    # HTF confirmation is a *bonus*, not a hard requirement.
    htf_long_ok = (not _ok(ema50_htf)) or (close > ema50_htf)
    htf_short_ok = (not _ok(ema50_htf)) or (close < ema50_htf)

    # ---- 3. GEX regime (fail-soft: missing/zero -> trend-following) -----
    gex = row.get("gex", 0.0)
    try:
        gex = float(gex)
    except (TypeError, ValueError):
        gex = 0.0

    if gex < 0:
        regime = "trend"
    elif gex > 0:
        regime = "mean_revert"
    else:
        regime = "trend"  # neutral default

    # ---- 4. ATR sanity (soft band, not hard reject) ---------------------
    if atr is None or atr <= 0 or math.isnan(atr):
        return None

    atr_pct = atr / close if close > 0 else 0.0
    # Soft penalty: extreme vol still allowed but flagged.
    vol_penalty = 0.0
    if atr_pct > 0.05:
        vol_penalty = 0.3
    elif atr_pct < 0.0005:
        vol_penalty = 0.2

    # ---- 5. Signal assembly --------------------------------------------
    direction = None
    strategy = None

    if regime == "trend":
        if long_trend and htf_long_ok and macro_score < BULLISH_THRESHOLD:
            direction, strategy = "long", "trend_follow"
        elif short_trend and htf_short_ok and macro_score > BEARISH_THRESHOLD:
            direction, strategy = "short", "trend_follow"
    else:  # mean_revert
        # Mean reversion: fade extension against the EMA stack.
        if long_trend and close < ema20 and macro_score < BULLISH_THRESHOLD:
            direction, strategy = "long", "mean_revert"
        elif short_trend and close > ema20 and macro_score > BEARISH_THRESHOLD:
            direction, strategy = "short", "mean_revert"

    if direction is None:
        return None

    # ---- 6. Risk sizing (ATR-based) ------------------------------------
    sl_dist = atr * 1.5
    if direction == "long":
        entry = close
        stop = entry - sl_dist
        tp1 = entry + sl_dist * 1.0
        tp2 = entry + sl_dist * 2.0
    else:
        entry = close
        stop = entry + sl_dist
        tp1 = entry - sl_dist * 1.0
        tp2 = entry - sl_dist * 2.0

    # ---- 7. Confidence score (for QA ranking) --------------------------
    confidence = 0.5
    if _ok(ema200):
        confidence += 0.15
    if _ok(ema50_htf):
        confidence += 0.10
    if abs(gex) > 0:
        confidence += 0.10
    confidence -= vol_penalty
    confidence = max(0.0, min(1.0, confidence))

    return {
        "direction": direction,
        "strategy": strategy,
        "regime": regime,
        "entry": float(entry),
        "stop": float(stop),
        "tp1": float(tp1),
        "tp2": float(tp2),
        "atr": float(atr),
        "confidence": float(confidence),
        "bar_index": int(i),
    }
