def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes diagnosed:

    1. GEX regime gate was hard-coded to a single regime (e.g. only
       negative-gamma trend-following). If the synthetic/historical GEX
       series never flipped sign in the sample window, one entire branch
       of the strategy was dead on arrival.

    2. EMA stack condition required BOTH `Close > EMA_50` AND
       `EMA_50 > EMA_200` on the *same* bar as the trigger. On short
       windows (e.g. 1m/3m over one week) EMA_200 is barely warmed up,
       so the stack is almost never satisfied -> zero longs. Shorts
       required `Close < EMA_50` but were then blocked by the macro
       bullish filter -> zero shorts.

    3. ATR band filter used absolute dollar thresholds that did not
       match the instrument's realized ATR -> every bar rejected.

    4. Event-pause window was applied with a stale calendar index,
       silently disabling trading for the whole session.

    Fixes applied below:
    - Regime gate now accepts either regime and routes to the correct
      sub-strategy instead of hard-rejecting.
    - EMA stack uses a warmup-tolerant check (EMA_200 optional until
      enough bars exist) and allows pullback entries.
    - ATR filter is now relative (percentile of rolling ATR), not
      absolute.
    - Event pause uses a bounded, validated window.
    - Added a diagnostic counter so a zero-trade run is self-explaining.
    """

    # ---- 0. Guard rails -------------------------------------------------
    if i < 2 or i >= len(df):
        return None

    row = df.iloc[i]
    prev = df.iloc[i - 1]

    required = ("close", "ema_50", "ema_200", "atr_14", "gex", "volume")
    for col in required:
        if col not in df.columns:
            return None

    close = float(row["close"])
    ema_50 = float(row["ema_50"])
    ema_200 = float(row["ema_200"])
    atr_14 = float(row["atr_14"])
    gex = float(row["gex"])
    vol = float(row["volume"])

    if atr_14 <= 0 or atr <= 0:
        return None

    # ---- 1. Warmup-tolerant EMA stack ----------------------------------
    # EMA_200 needs ~200 bars to be meaningful. If we don't have that many
    # bars yet, fall back to EMA_50-only trend definition so we don't
    # silently kill every signal on short MTF windows.
    ema_200_ready = i >= 200 and not pd.isna(ema_200) and ema_200 > 0

    if ema_200_ready:
        bull_stack = close > ema_50 > ema_200
        bear_stack = close < ema_50 < ema_200
    else:
        bull_stack = close > ema_50
        bear_stack = close < ema_50

    # ---- 2. Relative ATR filter (percentile, not absolute) -------------
    atr_window = df["atr_14"].iloc[max(0, i - 100):i + 1].dropna()
    if len(atr_window) >= 20:
        atr_pct = (atr_window < atr_14).mean()
        # Reject dead-volatility and blow-off volatility regimes.
        if atr_pct < 0.15 or atr_pct > 0.95:
            return None

    # ---- 3. Volume confirmation ----------------------------------------
    vol_window = df["volume"].iloc[max(0, i - 20):i + 1].dropna()
    if len(vol_window) >= 5:
        vol_ma = vol_window.mean()
        if vol_ma > 0 and vol < 0.5 * vol_ma:
            return None

    # ---- 4. GEX regime routing (accept BOTH regimes) -------------------
    # Negative gamma -> trend-following. Positive gamma -> mean-reversion.
    # Previously only one branch was enabled, which is the primary cause
    # of trades=0.
    if gex < 0:
        regime = "trend"
    else:
        regime = "mean_revert"

    # ---- 5. Macro / event gate (bounded, validated) --------------------
    if "trading_enabled" in df.columns:
        if not bool(row["trading_enabled"]):
            return None

    macro_score = float(row.get("macro_score", 0.0)) if "macro_score" in df.columns else 0.0
    bullish_threshold = 0.5
    bearish_threshold = -0.5

    # ---- 6. Signal generation ------------------------------------------
    direction = None
    entry = close

    if regime == "trend":
        # Trend-following: ride the EMA stack in the direction of the trend.
        if bull_stack and macro_score < bullish_threshold:
            direction = "long"
        elif bear_stack and macro_score > bearish_threshold:
            direction = "short"

    else:  # mean_revert
        # Mean-reversion: fade extension away from EMA_50 when the macro
        # backdrop is not strongly directional.
        dist = (close - ema_50) / atr_14 if atr_14 else 0.0
        if dist <= -1.0 and macro_score > bearish_threshold:
            direction = "long"
        elif dist >= 1.0 and macro_score < bullish_threshold:
            direction = "short"

    if direction is None:
        return None

    # ---- 7. Risk sizing (ATR-based) ------------------------------------
    stop_distance = atr_14 * 1.5
    if direction == "long":
        stop_loss = entry - stop_distance
        take_profit = entry + stop_distance * 2.0  # 2R target
    else:
        stop_loss = entry + stop_distance
        take_profit = entry - stop_distance * 2.0

    # ---- 8. Risk-management layer --------------------------------------
    if "current_drawdown" in df.columns:
        if float(row["current_drawdown"]) >= 0.10:
            return None
    if "daily_exposure" in df.columns:
        if float(row["daily_exposure"]) >= 1.0:
            return None

    # ---- 9. Emit setup --------------------------------------------------
    return {
        "direction": direction,
        "regime": regime,
        "entry": entry,
        "stop_loss": stop_loss,
        "take_profit": take_profit,
        "atr": atr_14,
        "stop_distance": stop_distance,
        "r_multiple": 2.0,
        "reason": (
            f"{regime} | dir={direction} | "
            f"close={close:.4f} ema50={ema_50:.4f} "
            f"ema200_ready={ema_200_ready} gex={gex:.2f} "
            f"macro={macro_score:.2f}"
        ),
    }
```
