def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Multi-timeframe confluence cluster evaluator.

    Returns a dict describing the trade setup if a valid confluence cluster
    exists at bar `i`, otherwise None.

    Confluence hierarchy (all must align):
      1. Regime filter (GEX proxy via realized-vol / trend regime)
      2. Directional bias (EMA_50 / EMA_200 stack)
      3. Volatility gate (ATR within sane bounds)
      4. Momentum confirmation (RSI + MACD histogram)
      5. Structure confirmation (recent swing high/low break)
      6. Multi-timeframe agreement (resampled 5m/15m/1h trend)
    """
    import numpy as np
    import pandas as pd

    # --- Guard: need enough history for all indicators ---
    MIN_BARS = 220
    if i < MIN_BARS or i >= len(df):
        return None

    row = df.iloc[i]

    # --- Required columns check ---
    required = ["open", "high", "low", "close", "volume",
                "ema_50", "ema_200", "rsi_14", "macd", "macd_signal",
                "atr_14"]
    for c in required:
        if c not in df.columns:
            return None

    close = float(row["close"])
    ema_50 = float(row["ema_50"])
    ema_200 = float(row["ema_200"])
    rsi = float(row["rsi_14"])
    macd = float(row["macd"])
    macd_sig = float(row["macd_signal"])
    atr_14 = float(row["atr_14"])
    vol = float(row["volume"])

    # --- Sanity: no NaNs ---
    if any(np.isnan(x) for x in [close, ema_50, ema_200, rsi, macd,
                                 macd_sig, atr_14, vol]):
        return None

    # --- Volatility gate (ATR must be sane relative to price) ---
    if atr_14 <= 0:
        return None
    atr_pct = atr_14 / close
    if atr_pct < 0.0005 or atr_pct > 0.05:
        return None

    # --- Liquidity gate ---
    avg_vol = float(df["volume"].iloc[max(0, i - 20):i].mean())
    if avg_vol <= 0 or vol < 0.5 * avg_vol:
        return None

    # --- Regime filter (GEX proxy) ---
    # Negative-gamma proxy: strong directional trend (price far from EMA_200
    # and EMAs stacked). Positive-gamma proxy: price pinned near EMA_50.
    ema_spread = (ema_50 - ema_200) / ema_200 if ema_200 != 0 else 0.0
    dist_from_ema50 = (close - ema_50) / ema_50 if ema_50 != 0 else 0.0

    trend_regime = abs(ema_spread) > 0.002 and abs(dist_from_ema50) > 0.001
    mean_rev_regime = abs(ema_spread) <= 0.002

    # --- Directional bias ---
    long_bias = close > ema_50 and ema_50 > ema_200
    short_bias = close < ema_50 and ema_50 < ema_200

    # --- Momentum confirmation ---
    macd_hist = macd - macd_sig
    long_mom = macd_hist > 0 and rsi > 50 and rsi < 75
    short_mom = macd_hist < 0 and rsi < 50 and rsi > 25

    # --- Structure confirmation: break of recent swing ---
    lookback = 20
    recent = df.iloc[i - lookback:i]
    swing_high = float(recent["high"].max())
    swing_low = float(recent["low"].min())
    long_struct = close > swing_high * 0.999
    short_struct = close < swing_low * 1.001

    # --- Multi-timeframe agreement (resample last ~200 bars) ---
    window = df.iloc[max(0, i - 200):i + 1].copy()
    if len(window) < 60:
        return None

    def _tf_trend(bars_per_tf: int) -> int:
        """Return +1 up, -1 down, 0 flat for a resampled timeframe."""
        if len(window) < bars_per_tf * 3:
            return 0
        n = len(window) // bars_per_tf
        if n < 3:
            return 0
        trimmed = window.iloc[-n * bars_per_tf:]
        agg = trimmed.groupby(np.arange(len(trimmed)) // bars_per_tf).agg(
            {"close": "last"}
        )
        c = agg["close"].values
        if len(c) < 3:
            return 0
        # simple slope via first vs last
        slope = c[-1] - c[0]
        thresh = 0.0005 * c[0]
        if slope > thresh:
            return 1
        if slope < -thresh:
            return -1
        return 0

    tf_5m = _tf_trend(5)
    tf_15m = _tf_trend(15)
    tf_1h = _tf_trend(60)

    mtf_long = (tf_5m + tf_15m + tf_1h) >= 2
    mtf_short = (tf_5m + tf_15m + tf_1h) <= -2

    # --- Assemble long / short confluence ---
    long_ok = (
        trend_regime
        and long_bias
        and long_mom
        and long_struct
        and mtf_long
    )
    short_ok = (
        trend_regime
        and short_bias
        and short_mom
        and short_struct
        and mtf_short
    )

    # Mean-reversion fallback (positive-gamma regime)
    mr_long = (
        mean_rev_regime
        and close < ema_50
        and rsi < 35
        and macd_hist > 0
        and mtf_long
    )
    mr_short = (
        mean_rev_regime
        and close > ema_50
        and rsi > 65
        and macd_hist < 0
        and mtf_short
    )

    direction = None
    if long_ok or mr_long:
        direction = "long"
    elif short_ok or mr_short:
        direction = "short"

    if direction is None:
        return None

    # --- Risk sizing ---
    sl_dist = atr_14 * 1.5
    if direction == "long":
        entry = close
        sl = entry - sl_dist
        tp1 = entry + sl_dist * 1.5
        tp2 = entry + sl_dist * 2.5
    else:
        entry = close
        sl = entry + sl_dist
        tp1 = entry - sl_dist * 1.5
        tp2 = entry - sl_dist * 2.5

    return {
        "direction": direction,
        "entry": float(entry),
        "sl": float(sl),
        "tp1": float(tp1),
        "tp2": float(tp2),
        "atr": float(atr_14),
        "rsi": float(rsi),
        "macd_hist": float(macd_hist),
        "ema_spread": float(ema_spread),
        "mtf": (tf_5m, tf_15m, tf_1h),
        "regime": "trend" if trend_regime else "mean_rev",
        "reason": (
            f"{direction} | regime={'trend' if trend_regime else 'mean_rev'} "
            f"| mtf={tf_5m},{tf_15m},{tf_1h} | rsi={rsi:.1f} "
            f"| macd_hist={macd_hist:.4f}"
        ),
    }
