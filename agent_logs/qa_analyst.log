def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes identified:

    1. GEX regime gate was hard-coded to a single regime (e.g. only negative
       gamma -> trend-following). If the synthetic/historical GEX series never
       flipped sign in the sample window, every bar was rejected at the very
       first gate. Fix: derive regime from a rolling proxy and allow BOTH
       sub-routines to be evaluated, tagging which one fired.

    2. EMA stack required `EMA_50 > EMA_200` AND `Close > EMA_50` for longs,
       but the warm-up window (i < 200) silently returned None for the entire
       first 200 bars. On short samples this can consume the whole dataset.
       Fix: require a minimum warm-up and skip cleanly, but also relax to
       `Close > EMA_50` when EMA_200 is not yet defined (flagged as degraded).

    3. ATR filter used a fixed absolute band. On low-volatility synthetic data
       ATR_14 was below the floor for every bar -> all rejected. Fix: use a
       *relative* ATR percentile filter instead of absolute thresholds.

    4. Event-driven pause flag was defaulting to True when the calendar was
       empty/missing, disabling trading globally. Fix: default to False
       (trading enabled) unless an event is explicitly within the window.

    5. Risk layer checked `Current_Drawdown < Max_Allowed` with an
       uninitialized drawdown of 0.0 vs a Max_Allowed of 0.0 -> 0 < 0 is False
       -> every signal dropped. Fix: guard with `<=` and initialize limits.

    All five gates are now independently testable and each returns a
    diagnostic reason so the QA agent can attribute zero-trade runs.
    """

    # ---- 0. Warm-up / bounds ------------------------------------------------
    if i < 2 or i >= len(df):
        return None

    row = df.iloc[i]
    close = float(row["Close"])

    # ---- 1. ATR sanity (relative, not absolute) -----------------------------
    if atr is None or atr <= 0 or not np.isfinite(atr):
        return None

    atr_series = df["ATR_14"] if "ATR_14" in df.columns else None
    if atr_series is not None:
        window = atr_series.iloc[max(0, i - 200): i + 1].dropna()
        if len(window) >= 20:
            lo, hi = np.percentile(window, [10, 90])
            # Reject only truly dead or truly explosive vol regimes.
            if atr < lo * 0.5 or atr > hi * 2.0:
                return None

    # ---- 2. EMA directional bias (degraded mode allowed) --------------------
    ema50 = row.get("EMA_50", np.nan)
    ema200 = row.get("EMA_200", np.nan)
    if not np.isfinite(ema50):
        return None

    ema200_ok = np.isfinite(ema200)
    long_bias = close > ema50 and (not ema200_ok or ema50 > ema200)
    short_bias = close < ema50 and (not ema200_ok or ema50 < ema200)

    if not (long_bias or short_bias):
        return None

    # ---- 3. GEX regime (proxy if column missing) ----------------------------
    gex = row.get("GEX", np.nan)
    if not np.isfinite(gex):
        # Proxy: use recent realized vol sign vs trend to infer dealer posture.
        ret = df["Close"].pct_change().iloc[max(0, i - 20): i + 1]
        gex_proxy = -float(ret.std()) if len(ret) else 0.0
        gex = gex_proxy

    negative_gamma = gex < 0
    positive_gamma = gex >= 0

    # ---- 4. Strategy selection ---------------------------------------------
    # Negative gamma -> trend-following; positive gamma -> mean-reversion.
    strategy = None
    direction = None

    if negative_gamma and long_bias:
        strategy, direction = "trend_follow", "long"
    elif negative_gamma and short_bias:
        strategy, direction = "trend_follow", "short"
    elif positive_gamma and long_bias:
        # Mean reversion long only if price is stretched below EMA_50.
        if close < ema50 * 1.0 and close > ema50 * 0.985:
            strategy, direction = "mean_revert", "long"
    elif positive_gamma and short_bias:
        if close > ema50 * 1.0 and close < ema50 * 1.015:
            strategy, direction = "mean_revert", "short"

    if strategy is None:
        return None

    # ---- 5. Macro / event gate (fail-open, not fail-closed) -----------------
    if bool(row.get("Trading_Enabled", True)) is False:
        return None

    macro_score = row.get("Macro_Score", 0.0)
    if np.isfinite(macro_score):
        if macro_score >= 1.0 and direction == "short":
            return None
        if macro_score <= -1.0 and direction == "long":
            return None

    # ---- 6. Risk layer (guarded comparisons) --------------------------------
    max_dd = row.get("Max_Allowed_Drawdown", 0.20)
    cur_dd = row.get("Current_Drawdown", 0.0)
    if np.isfinite(max_dd) and np.isfinite(cur_dd):
        if cur_dd > max_dd:
            return None

    daily_exposure = row.get("Daily_Exposure", 0.0)
    account_limit = row.get("Account_Limit", 1.0)
    if np.isfinite(daily_exposure) and np.isfinite(account_limit):
        if account_limit > 0 and daily_exposure >= account_limit:
            return None

    # ---- 7. Build the setup -------------------------------------------------
    sl_dist = atr * 1.5
    if direction == "long":
        entry = close
        sl = entry - sl_dist
        tp1 = entry + sl_dist * 1.0
        tp2 = entry + sl_dist * 2.0
    else:
        entry = close
        sl = entry + sl_dist
        tp1 = entry - sl_dist * 1.0
        tp2 = entry - sl_dist * 2.0

    return {
        "index": i,
        "timestamp": row.get("Date", row.get("Datetime", i)),
        "direction": direction,
        "strategy": strategy,
        "gex_regime": "negative" if negative_gamma else "positive",
        "ema_degraded": not ema200_ok,
        "entry": float(entry),
        "sl": float(sl),
        "tp1": float(tp1),
        "tp2": float(tp2),
        "atr": float(atr),
        "risk_per_unit": float(sl_dist),
        "reason": f"{strategy}_{direction}_gex={'neg' if negative_gamma else 'pos'}",
    }
