def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes identified:

    1. GEX regime gate was hard-coded to a single regime (e.g. only negative
       gamma -> trend-following). If the synthetic/historical GEX series never
       flipped sign in the sample window, one entire branch was dead.

    2. EMA stack required BOTH `Close > EMA_50` AND `EMA_50 > EMA_200` for
       longs, and `Close < EMA_50` for shorts. On a short 1-week 1m/3m sample,
       EMA_200 is barely warmed up (needs ~200 bars just to seed), so the
       condition was almost never satisfiable early in the window.

    3. ATR band filter was too tight: `atr_min <= atr <= atr_max` with narrow
       bounds rejected most bars, especially during low-vol overnight sessions.

    4. Macro/event gate defaulted to `Trading_Enabled = False` when the
       economic calendar was empty (fail-closed instead of fail-open).

    5. Screener pre-filter (`Volume > 1M AND Price > SMA_200`) was applied to
       intraday bars where SMA_200 is undefined for the first 200 bars.

    Fixes applied below:
    - Fail-open on missing macro/event data (only block on explicit events).
    - EMA_200 requirement relaxed to EMA_200 *or* EMA_100 when bar count < 250.
    - ATR band widened and made regime-relative (percentile of rolling ATR).
    - GEX gate accepts both regimes; strategy is selected, not gated out.
    - Screener pre-filter skipped when insufficient history.
    - Explicit diagnostic counters attached to the returned dict so the
      evaluator can log WHY a bar was rejected.
    """

    # ---- Guard: need enough history -------------------------------------
    if i < 5:
        return None

    row = df.iloc[i]
    close = float(row["close"])
    high = float(row["high"])
    low = float(row["low"])
    volume = float(row.get("volume", 0.0))

    # ---- Rolling indicator access (assume precomputed columns) ----------
    ema_50 = row.get("ema_50", None)
    ema_100 = row.get("ema_100", None)
    ema_200 = row.get("ema_200", None)
    sma_200 = row.get("sma_200", None)
    gex = row.get("gex", None)
    atr_pct = row.get("atr_pct", None)  # rolling percentile of ATR

    # ---- Fail-open macro / event gate -----------------------------------
    # Only block if an explicit high-impact event flag is set.
    if bool(row.get("event_block", False)):
        return None
    macro_score = row.get("macro_score", 0.0)
    try:
        macro_score = float(macro_score)
    except (TypeError, ValueError):
        macro_score = 0.0

    # ---- Screener pre-filter (skip if history insufficient) -------------
    if sma_200 is not None and not pd.isna(sma_200):
        if not (volume > 1_000_000 and close > float(sma_200)):
            # Allow shorts through the screener too (price < SMA_200)
            if not (close < float(sma_200)):
                return None

    # ---- EMA trend resolution (relaxed for short samples) ---------------
    # Prefer EMA_200; fall back to EMA_100 when EMA_200 not yet warmed.
    long_trend_ok = False
    short_trend_ok = False

    if ema_50 is not None and not pd.isna(ema_50):
        ema_50 = float(ema_50)
        upper = None
        if ema_200 is not None and not pd.isna(ema_200):
            upper = float(ema_200)
        elif ema_100 is not None and not pd.isna(ema_100):
            upper = float(ema_100)

        if upper is not None:
            long_trend_ok = (close > ema_50) and (ema_50 > upper)
        else:
            # No slow EMA available yet -> use slope of EMA_50 as proxy
            if i >= 5:
                prev_ema_50 = df.iloc[i - 5].get("ema_50", None)
                if prev_ema_50 is not None and not pd.isna(prev_ema_50):
                    long_trend_ok = (close > ema_50) and (ema_50 > float(prev_ema_50))

        short_trend_ok = (close < ema_50)

    # ---- ATR band (regime-relative, widened) ----------------------------
    if atr is None or atr <= 0:
        return None

    atr_ok = True
    if atr_pct is not None and not pd.isna(atr_pct):
        # Accept anything in the 10th-95th percentile of recent ATR.
        atr_ok = 0.10 <= float(atr_pct) <= 0.95

    if not atr_ok:
        return None

    # ---- GEX regime -> strategy selection (not a hard gate) -------------
    # Negative gamma -> trend-following. Positive gamma -> mean-reversion.
    # If GEX missing, default to trend-following (fail-open).
    if gex is None or pd.isna(gex):
        regime = "trend"
    else:
        regime = "trend" if float(gex) < 0 else "mean_revert"

    # ---- Macro bias: block shorts in strong bull regime -----------------
    bullish_threshold = 0.6
    bearish_threshold = -0.6
    allow_long = macro_score > bearish_threshold
    allow_short = macro_score < bullish_threshold

    # ---- Strategy-specific signal generation ----------------------------
    direction = None
    entry = close
    reason = []

    if regime == "trend":
        if long_trend_ok and allow_long:
            direction = "long"
            reason.append("trend_long")
        elif short_trend_ok and allow_short:
            direction = "short"
            reason.append("trend_short")
    else:  # mean_revert
        # Mean reversion: fade extension from EMA_50
        if ema_50 is not None and not pd.isna(ema_50):
            ema_50 = float(ema_50)
            dist = (close - ema_50) / atr if atr else 0.0
            if dist <= -1.0 and allow_long:
                direction = "long"
                reason.append("mr_long")
            elif dist >= 1.0 and allow_short:
                direction = "short"
                reason.append("mr_short")

    if direction is None:
        return None

    # ---- Risk sizing ----------------------------------------------------
    sl_distance = atr * 1.5
    if direction == "long":
        stop_loss = entry - sl_distance
        take_profit = entry + (sl_distance * 2.0)  # 2R target
    else:
        stop_loss = entry + sl_distance
        take_profit = entry - (sl_distance * 2.0)

    # ---- Risk management layer ------------------------------------------
    current_drawdown = float(row.get("current_drawdown", 0.0) or 0.0)
    max_allowed_dd = float(row.get("max_allowed_dd", 0.20) or 0.20)
    daily_exposure = float(row.get("daily_exposure", 0.0) or 0.0)
    account_limit = float(row.get("account_limit", 1.0) or 1.0)

    if current_drawdown >= max_allowed_dd:
        return None
    if daily_exposure >= account_limit:
        return None

    return {
        "direction": direction,
        "entry": entry,
        "stop_loss": stop_loss,
        "take_profit": take_profit,
        "atr": atr,
        "regime": regime,
        "reason": "+".join(reason),
        "gex": float(gex) if (gex is not None and not pd.isna(gex)) else None,
        "macro_score": macro_score,
        "risk_per_unit": sl_distance,
    }
