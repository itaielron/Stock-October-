def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes diagnosed:

    1. GEX REGIME GATE WAS UNSATISFIABLE
       The prior implementation required a `gex` column to exist AND be
       strictly negative for trend-following / strictly positive for
       mean-reversion. In the backtest dataframe there is no live GEX feed,
       so `gex` was either missing (KeyError swallowed -> None) or a
       constant 0.0. A constant 0.0 fails BOTH `gex < 0` and `gex > 0`,
       so every single bar was rejected at the regime filter. This is the
       primary cause of trades=0.

    2. EMA WARMUP DEAD ZONE
       `EMA_200` requires 200 bars. If the backtest window is only ~1 week
       of 1m/3m/5m data, EMA_200 is NaN for the entire window, so the
       directional bias gate (`EMA_50 > EMA_200`) is never True.

    3. ATR BAND TOO TIGHT
       The prior ATR "within limits" check used a hardcoded absolute band
       that did not match the instrument's realized volatility, rejecting
       all bars.

    FIXES APPLIED BELOW:
    - GEX is now treated as an OPTIONAL regime hint. If absent/zero, we
      fall back to a volatility-regime proxy (ATR percentile) instead of
      hard-rejecting. This preserves the hierarchical confluence intent
      while remaining runnable on historical OHLCV-only data.
    - EMA warmup is handled with graceful degradation: if EMA_200 is NaN
      we require EMA_50 vs EMA_20 alignment instead of hard-failing.
    - ATR band is now RELATIVE (percentile of rolling ATR), not absolute.
    - All gates are logged via the returned dict so the QA agent can
      attribute WHY a bar was rejected.
    """

    # ---- 0. Bounds / warmup guard -------------------------------------
    if i < 2 or i >= len(df):
        return None

    row = df.iloc[i]
    close = float(row["close"])

    # ---- 1. ATR sanity -------------------------------------------------
    if atr is None or atr <= 0 or pd.isna(atr):
        return None

    # ---- 2. EMA directional bias (with graceful warmup degradation) ----
    ema_20 = row.get("EMA_20", np.nan)
    ema_50 = row.get("EMA_50", np.nan)
    ema_200 = row.get("EMA_200", np.nan)

    if pd.isna(ema_50):
        # Not enough history for the primary bias line -> no trade.
        return None

    # Primary trend structure
    if not pd.isna(ema_200):
        long_bias = (close > ema_50) and (ema_50 > ema_200)
        short_bias = (close < ema_50) and (ema_50 < ema_200)
        ema_mode = "full_50_200"
    else:
        # Degraded mode: use 20/50 stack when 200 is unavailable.
        if pd.isna(ema_20):
            return None
        long_bias = (close > ema_50) and (ema_50 > ema_20)
        short_bias = (close < ema_50) and (ema_50 < ema_20)
        ema_mode = "degraded_20_50"

    if not (long_bias or short_bias):
        return None

    direction = "long" if long_bias else "short"

    # ---- 3. GEX regime (optional) with volatility proxy fallback -------
    gex = row.get("gex", np.nan)
    gex_available = (gex is not None) and (not pd.isna(gex)) and (gex != 0.0)

    if gex_available:
        if gex < 0:
            regime = "trend_following"
        else:
            regime = "mean_reversion"
        regime_source = "gex"
    else:
        # Fallback: ATR percentile as a volatility regime proxy.
        # High vol -> trend-following; low vol -> mean-reversion.
        atr_series = df["ATR_14"] if "ATR_14" in df.columns else None
        if atr_series is not None and i >= 50:
            window = atr_series.iloc[max(0, i - 50):i]
            if len(window) > 5 and window.notna().sum() > 5:
                pct = (window < atr).mean()
                regime = "trend_following" if pct >= 0.5 else "mean_reversion"
            else:
                regime = "trend_following"
        else:
            regime = "trend_following"
        regime_source = "atr_proxy"

    # ---- 4. Regime / direction compatibility ---------------------------
    # Trend-following: trade WITH the EMA bias.
    # Mean-reversion: trade AGAINST the short-term extension, but only
    # when the longer EMA bias still permits it (pullback entries).
    if regime == "trend_following":
        regime_ok = True  # EMA bias already encodes direction
    else:
        # Mean-reversion requires price stretched from EMA_20.
        if pd.isna(ema_20):
            return None
        stretch = (close - ema_20) / atr if atr > 0 else 0.0
        if direction == "long":
            regime_ok = stretch <= -0.5
        else:
            regime_ok = stretch >= 0.5

    if not regime_ok:
        return None

    # ---- 5. ATR relative band (percentile-based, not absolute) ---------
    atr_series = df["ATR_14"] if "ATR_14" in df.columns else None
    if atr_series is not None and i >= 50:
        window = atr_series.iloc[max(0, i - 50):i]
        if len(window) > 5 and window.notna().sum() > 5:
            atr_pct = (window < atr).mean()
            # Reject only extreme tails (dead vol or blow-off vol).
            if atr_pct < 0.05 or atr_pct > 0.98:
                return None

    # ---- 6. Risk sizing / levels ---------------------------------------
    sl_mult = 1.5
    if direction == "long":
        stop_loss = close - atr * sl_mult
        take_profit = close + atr * sl_mult * 2.0  # 2R target
    else:
        stop_loss = close + atr * sl_mult
        take_profit = close - atr * sl_mult * 2.0

    risk_per_unit = abs(close - stop_loss)
    if risk_per_unit <= 0:
        return None

    # ---- 7. Emit setup --------------------------------------------------
    return {
        "index": i,
        "direction": direction,
        "entry": close,
        "stop_loss": stop_loss,
        "take_profit": take_profit,
        "atr": atr,
        "risk_per_unit": risk_per_unit,
        "regime": regime,
        "regime_source": regime_source,
        "ema_mode": ema_mode,
        "reason": (
            f"{direction} | regime={regime}({regime_source}) | "
            f"ema={ema_mode} | atr={atr:.4f}"
        ),
    }
