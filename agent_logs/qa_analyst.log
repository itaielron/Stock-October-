# QA instrumentation guard — re-issued verbatim. The Coder has now had FIVE cycles
# to implement this and has not. The backtest is frozen for tuning until it passes.
# This is the minimum observability contract.

def emit_summary(trades, winners, losers, total_R, chart_files, gate_counts,
                 gex_coverage, total_bars, warmup, min_sample=30):
    """
    Enforce the QA observability contract. Raises if the run is invalid or
    under-instrumented, so a thin/zero-signal run can never masquerade as a SUMMARY.
    """
    # --- 1. Status + win rate must never be a bare 0.0% on thin/empty samples ---
    if trades == 0:
        win_rate = "N/A"
        status = "NO_SIGNAL"
    elif trades < min_sample:
        win_rate = f"{100.0 * winners / trades:.1f}%"
        status = "INSUFFICIENT_SAMPLE"
    else:
        win_rate = f"{100.0 * winners / trades:.1f}%"
        status = "OK"

    # --- 2. Charts must be counted, not a directory path ---
    n_charts = len(chart_files)

    # --- 3. Per-gate pass counts must be present ---
    required_gates = ("ema", "gex", "sr", "atr", "all")
    missing = [g for g in required_gates if g not in gate_counts]
    if missing:
        raise RuntimeError(f"INSTRUMENTATION MISSING: gate pass counts absent for {missing}")

    # --- 4. GEX coverage must be reported and sufficient ---
    gex_ratio = gex_coverage / total_bars if total_bars else 0.0
    if gex_ratio < 0.5:
        raise RuntimeError(
            f"GEX COVERAGE TOO LOW: {gex_coverage}/{total_bars} ({gex_ratio:.0%}) — "
            "confluence AND-gate is silently starved."
        )

    # --- 5. Thin/zero-signal runs are flagged, not summarized as normal ---
    if trades == 0:
        print("[WARN] NO TRADES — confluence over-constrained or data missing")
    elif trades < min_sample:
        print(f"[WARN] LOW SAMPLE n={trades} (<{min_sample}) — win rate is not statistically meaningful")

    # --- 6. Warmup accounting ---
    tradeable_bars = total_bars - warmup
    if tradeable_bars < 50:
        print(f"[WARN] tradeable_bars={tradeable_bars} (<50) — warmup starvation likely")

    # --- 7. Chart annotation verification ---
    if trades > 0 and n_charts == 0:
        raise RuntimeError("CHART FAILURE: trades>0 but charts=0")
    if trades == 0 and n_charts > 0:
        print(f"[WARN] {n_charts} chart(s) emitted with 0 trades — empty panels, no entry/TP/SL markers")

    print("=" * 70)
    print(f"STATUS={status} trades={trades} winners={winners} losers={losers} "
          f"win_rate={win_rate} total_R={total_R:+.2f} charts={n_charts}")
    print(f"gate_counts={gate_counts} gex_coverage={gex_coverage}/{total_bars} "
          f"tradeable_bars={tradeable_bars}")
    print("=" * 70)

    return status
```

