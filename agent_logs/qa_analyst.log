def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster detector with multi-timeframe awareness.

    Returns a dict describing the trade setup, or None if no valid setup.

    NOTE ON trades=0:
    -----------------
    The previous run produced zero trades. Root causes identified:

    1. GEX regime gate was hard-coded to a single regime (e.g. only negative
       gamma -> trend-following). If the synthetic/historical GEX series never
       flipped sign in the sample window, every bar was rejected at the very
       first gate. Fix: derive regime from a rolling proxy (dealer gamma sign
       via price-vs-VWAP + realized-vol skew) and allow BOTH sub-routines to
       be evaluated, tagging the regime rather than hard-rejecting.

    2. EMA stack required Close > EMA50 > EMA200 on EVERY bar. On short
       windows (1 week of 1m/3m data) EMA200 is not yet warmed up, so the
       condition is NaN -> False -> zero signals. Fix: require EMA warmup
       (min_periods) and fall back to EMA50 vs EMA200 slope when EMA200 is
       still forming, plus a hard warmup guard that returns None early.

    3. ATR filter used a fixed absolute band. On low-volatility windows ATR
       collapsed below the floor and every bar was filtered. Fix: use
       percentile-based ATR band computed on the available window.

    4. Macro/event gate defaulted to Trading_Enabled=False when the calendar
       was empty. Fix: default to enabled unless an event is explicitly found.

    5. MTFA confluence required ALL timeframes to agree simultaneously, which
       is statistically near-impossible on a 1-week sample. Fix: require a
       weighted score >= threshold instead of unanimity.

    These fixes are applied below. The function remains a pure, side-effect
    free evaluator so the backtest loop can call it per-bar.
    """

    # ---- 0. Warmup / bounds guard -------------------------------------
    MIN_BARS = 210  # need EMA200 + ATR14 + lookback
    if i < MIN_BARS or i >= len(df):
        return None

    row = df.iloc[i]
    close = float(row["close"])
    if not np.isfinite(close) or close <= 0:
        return None

    # ---- 1. ATR sanity (percentile band, not fixed absolute) ----------
    atr_series = df["atr14"].iloc[max(0, i - 200): i + 1].dropna()
    if len(atr_series) < 20:
        return None
    atr_lo = float(atr_series.quantile(0.10))
    atr_hi = float(atr_series.quantile(0.95))
    if not (atr_lo <= atr <= atr_hi) or atr <= 0:
        return None

    # ---- 2. EMA trend structure ---------------------------------------
    ema50 = float(row.get("ema50", np.nan))
    ema200 = float(row.get("ema200", np.nan))
    if not np.isfinite(ema50):
        return None

    # EMA200 may still be warming up on short windows -> use slope fallback
    if np.isfinite(ema200):
        bull_trend = close > ema50 > ema200
        bear_trend = close < ema50 < ema200
    else:
        ema50_prev = float(df["ema50"].iloc[i - 10])
        slope_up = ema50 > ema50_prev
        bull_trend = close > ema50 and slope_up
        bear_trend = close < ema50 and not slope_up

    if not (bull_trend or bear_trend):
        return None

    # ---- 3. GEX regime (proxy, not hard-coded) ------------------------
    # Proxy: negative gamma when price is extended from VWAP AND realized
    # vol is rising (dealers chase); positive gamma when price is pinned
    # near VWAP with falling realized vol.
    vwap = float(row.get("vwap", np.nan))
    rv = float(row.get("realized_vol", np.nan))
    rv_prev = float(df["realized_vol"].iloc[i - 5]) if "realized_vol" in df else np.nan

    if np.isfinite(vwap) and np.isfinite(rv) and np.isfinite(rv_prev):
        dist = (close - vwap) / max(vwap, 1e-9)
        vol_rising = rv > rv_prev
        gex_negative = abs(dist) > 0.002 and vol_rising
        gex_positive = abs(dist) <= 0.002 and not vol_rising
    else:
        # No proxy data -> do not hard-reject; treat as neutral and let
        # other confluences decide.
        gex_negative = False
        gex_positive = False

    # ---- 4. MTFA confluence scoring (weighted, not unanimous) ---------
    tf_cols = {
        "1m":  ("ema50_1m",  "ema200_1m",  0.10),
        "3m":  ("ema50_3m",  "ema200_3m",  0.10),
        "5m":  ("ema50_5m",  "ema200_5m",  0.15),
        "15m": ("ema50_15m", "ema200_15m", 0.20),
        "1h":  ("ema50_1h",  "ema200_1h",  0.20),
        "4h":  ("ema50_4h",  "ema200_4h",  0.25),
    }

    long_score = 0.0
    short_score = 0.0
    for _tf, (c50, c200, w) in tf_cols.items():
        if c50 not in df.columns:
            continue
        f50 = float(row.get(c50, np.nan))
        f200 = float(row.get(c200, np.nan))
        if not np.isfinite(f50):
            continue
        if np.isfinite(f200):
            if f50 > f200:
                long_score += w
            elif f50 < f200:
                short_score += w
        else:
            # partial credit when only the fast EMA is available
            if f50 < close:
                long_score += w * 0.5
            else:
                short_score += w * 0.5

    MTFA_THRESHOLD = 0.55  # weighted agreement, not unanimity

    # ---- 5. Regime <-> direction compatibility ------------------------
    # Negative gamma -> trend-following (align with EMA trend)
    # Positive gamma -> mean-reversion (fade extension toward VWAP)
    direction = None
    strategy = None

    if gex_negative:
        strategy = "trend"
        if bull_trend and long_score >= MTFA_THRESHOLD:
            direction = "long"
        elif bear_trend and short_score >= MTFA_THRESHOLD:
            direction = "short"
    elif gex_positive:
        strategy = "mean_reversion"
        if np.isfinite(vwap):
            if close < vwap and long_score >= MTFA_THRESHOLD:
                direction = "long"
            elif close > vwap and short_score >= MTFA_THRESHOLD:
                direction = "short"
    else:
        # Neutral regime: fall back to trend alignment with stricter MTFA
        strategy = "trend_neutral"
        if bull_trend and long_score >= MTFA_THRESHOLD + 0.10:
            direction = "long"
        elif bear_trend and short_score >= MTFA_THRESHOLD + 0.10:
            direction = "short"

    if direction is None:
        return None

    # ---- 6. Macro / event gate (default ENABLED) ----------------------
    if bool(row.get("event_pause", False)):
        return None
    macro_score = float(row.get("macro_score", 0.0))
    BULLISH_THRESHOLD = 0.5
    BEARISH_THRESHOLD = -0.5
    if macro_score >= BULLISH_THRESHOLD and direction == "short":
        return None
    if macro_score <= BEARISH_THRESHOLD and direction == "long":
        return None

    # ---- 7. Risk layer -------------------------------------------------
    max_dd = float(row.get("current_drawdown", 0.0))
    if max_dd > 0.10:  # 10% drawdown kill-switch
        return None
    daily_exposure = float(row.get("daily_exposure", 0.0))
    if daily_exposure > 0.80:  # 80% of account limit
        return None

    # ---- 8. Build the setup -------------------------------------------
    atr_stop = atr * 1.5
    if direction == "long":
        entry = close
        sl = entry - atr_stop
        tp1 = entry + atr_stop * 1.0
        tp2 = entry + atr_stop * 2.0
    else:
        entry = close
        sl = entry + atr_stop
        tp1 = entry - atr_stop * 1.0
        tp2 = entry - atr_stop * 2.0

    return {
        "direction": direction,
        "strategy": strategy,
        "entry": entry,
        "sl": sl,
        "tp1": tp1,
        "tp2": tp2,
        "atr": atr,
        "atr_stop": atr_stop,
        "long_score": long_score,
        "short_score": short_score,
        "gex_negative": gex_negative,
        "gex_positive": gex_positive,
        "macro_score": macro_score,
        "reason": (
            f"{strategy}|dir={direction}|L={long_score:.2f}|S={short_score:.2f}"
            f"|gex_neg={gex_negative}|gex_pos={gex_positive}"
        ),
    }
