def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Evaluate confluence cluster at bar index i across multi-timeframe context.

    Returns a dict describing the trade setup, or None if no valid setup.

    Confluence hierarchy (per Quant Research Report):
      1. Regime Filter (GEX)  -> trend-following vs mean-reversion
      2. Directional Bias (EMA50/EMA200)
      3. Volatility / Risk (ATR14 * 1.5)
      4. Multi-timeframe alignment (1m,3m,5m,15m,1h,4h)
      5. Macro regime score gate
      6. Event-driven pause gate
      7. Risk management layer (drawdown / daily exposure)
    """
    import numpy as np
    import pandas as pd

    # --- Guard: need enough history for EMA200 + ATR14 + lookback ---
    MIN_BARS = 210
    if i < MIN_BARS or i >= len(df):
        return None

    row = df.iloc[i]

    # --- Required columns guard ---
    required = ("close", "high", "low", "ema_50", "ema_200", "atr_14")
    for col in required:
        if col not in df.columns:
            return None

    close = float(row["close"])
    high = float(row["high"])
    low = float(row["low"])
    ema_50 = float(row["ema_50"])
    ema_200 = float(row["ema_200"])
    atr_14 = float(row["atr_14"])

    if not np.isfinite([close, high, low, ema_50, ema_200, atr_14]).all():
        return None
    if atr_14 <= 0:
        return None

    # --- 1. Regime Filter (GEX) ---
    gex = float(row.get("gex", 0.0)) if "gex" in df.columns else 0.0
    if not np.isfinite(gex):
        gex = 0.0
    # GEX < 0 -> trend-following ; GEX > 0 -> mean-reversion
    regime = "trend" if gex < 0 else "mean_reversion"

    # --- 2. Directional Bias (EMA) ---
    long_bias = (close > ema_50) and (ema_50 > ema_200)
    short_bias = (close < ema_50) and (ema_50 < ema_200)

    # --- 3. Volatility / Risk Sizing (ATR) ---
    atr_stop = atr_14 * 1.5
    # ATR sanity band: avoid dead / explosive vol regimes
    atr_pct = atr_14 / close if close > 0 else 0.0
    if atr_pct < 0.0005 or atr_pct > 0.05:
        return None

    # --- 4. Multi-timeframe alignment ---
    # Expect precomputed MTF EMA columns; fall back to base EMA if absent.
    mtf_tfs = ("1m", "3m", "5m", "15m", "1h", "4h")
    mtf_long_votes = 0
    mtf_short_votes = 0
    mtf_available = 0
    for tf in mtf_tfs:
        col = f"ema_50_{tf}"
        if col in df.columns:
            v = float(row[col])
            if np.isfinite(v):
                mtf_available += 1
                if close > v:
                    mtf_long_votes += 1
                elif close < v:
                    mtf_short_votes += 1
    # Require majority alignment when MTF data is present
    if mtf_available >= 3:
        mtf_long_ok = mtf_long_votes >= (mtf_available * 0.6)
        mtf_short_ok = mtf_short_votes >= (mtf_available * 0.6)
    else:
        mtf_long_ok = True
        mtf_short_ok = True

    # --- 5. Macro regime score gate ---
    macro_score = float(row.get("macro_score", 0.0)) if "macro_score" in df.columns else 0.0
    if not np.isfinite(macro_score):
        macro_score = 0.0
    BULLISH_THRESHOLD = 0.5
    BEARISH_THRESHOLD = -0.5
    macro_blocks_short = macro_score >= BULLISH_THRESHOLD
    macro_blocks_long = macro_score <= BEARISH_THRESHOLD

    # --- 6. Event-driven pause gate ---
    trading_enabled = bool(row.get("trading_enabled", True))
    if not trading_enabled:
        return None

    # --- 7. Risk management layer ---
    current_drawdown = float(row.get("current_drawdown", 0.0)) if "current_drawdown" in df.columns else 0.0
    daily_exposure = float(row.get("daily_exposure", 0.0)) if "daily_exposure" in df.columns else 0.0
    MAX_DRAWDOWN = 0.20
    MAX_DAILY_EXPOSURE = 1.0
    if current_drawdown >= MAX_DRAWDOWN or daily_exposure >= MAX_DAILY_EXPOSURE:
        return None

    # --- Confluence scoring ---
    # Trend-following regime: require EMA trend alignment + MTF alignment
    # Mean-reversion regime: require price stretched from EMA50 + MTF exhaustion
    direction = None
    setup_type = None

    if regime == "trend":
        if long_bias and mtf_long_ok and not macro_blocks_long:
            direction = "long"
            setup_type = "trend_follow_long"
        elif short_bias and mtf_short_ok and not macro_blocks_short:
            direction = "short"
            setup_type = "trend_follow_short"
    else:  # mean_reversion
        # Stretch measured in ATR units from EMA50
        stretch = (close - ema_50) / atr_14 if atr_14 > 0 else 0.0
        if stretch <= -1.5 and mtf_short_ok and not macro_blocks_long:
            direction = "long"
            setup_type = "mean_revert_long"
        elif stretch >= 1.5 and mtf_long_ok and not macro_blocks_short:
            direction = "short"
            setup_type = "mean_revert_short"

    if direction is None:
        return None

    # --- Build trade plan ---
    if direction == "long":
        entry = close
        stop_loss = entry - atr_stop
        take_profit_1 = entry + (atr_stop * 1.5)   # 1.5R
        take_profit_2 = entry + (atr_stop * 2.5)   # 2.5R
    else:
        entry = close
        stop_loss = entry + atr_stop
        take_profit_1 = entry - (atr_stop * 1.5)
        take_profit_2 = entry - (atr_stop * 2.5)

    risk_per_unit = abs(entry - stop_loss)
    if risk_per_unit <= 0:
        return None

    return {
        "index": int(i),
        "timestamp": row.get("timestamp", None),
        "direction": direction,
        "setup_type": setup_type,
        "regime": regime,
        "gex": gex,
        "macro_score": macro_score,
        "entry": float(entry),
        "stop_loss": float(stop_loss),
        "take_profit_1": float(take_profit_1),
        "take_profit_2": float(take_profit_2),
        "atr": float(atr_14),
        "atr_stop": float(atr_stop),
        "risk_per_unit": float(risk_per_unit),
        "rr_tp1": 1.5,
        "rr_tp2": 2.5,
        "mtf_long_votes": int(mtf_long_votes),
        "mtf_short_votes": int(mtf_short_votes),
        "mtf_available": int(mtf_available),
        "confluence_score": int(
            (1 if regime == "trend" else 0)
            + (1 if (long_bias or short_bias) else 0)
            + (1 if mtf_available >= 3 else 0)
            + (1 if abs(macro_score) < BULLISH_THRESHOLD else 0)
        ),
    }
