def _confluence_cluster(df: pd.DataFrame, i: int, atr: float) -> dict | None:
    """
    Confluence cluster evaluator.

    NOTE ON THE PREVIOUS RUN (trades=0):
    ------------------------------------
    The prior backtest produced zero trades. Root cause analysis:

    1. GEX REGIME GATE WAS UNSATISFIABLE:
       The regime filter required `gex < 0` for trend-following and `gex > 0`
       for mean-reversion. In the historical dataframe, the `gex` column was
       either (a) absent, (b) all-NaN, or (c) constant zero. Any of these
       collapses the regime branch and no signal can ever fire. We now treat
       a missing/NaN/zero GEX as a NEUTRAL regime and fall back to pure
       EMA+ATR confluence instead of hard-blocking.

    2. EMA WARMUP DEADLOCK:
       `Close > EMA_50 AND EMA_50 > EMA_200` requires at least 200 bars of
       history. If the loop started at i=0 or the dataframe was shorter than
       ~200 bars, every comparison was NaN -> False -> no trades. We now
       guard with an explicit warmup check and return None early.

    3. ATR BAND WAS TOO TIGHT:
       The ATR "within limits" check used a hardcoded band that excluded the
       actual ATR distribution of the sample. We now use a percentile-based
       band computed from the rolling ATR so the gate adapts to the regime.

    4. STRICT AND-CHAIN:
       Every condition was ANDed with no fallback, so a single NaN anywhere
       killed the signal. We now use explicit NaN-safe comparisons.

    This rewrite keeps the hierarchical confluence structure (Regime ->
    Direction -> Volatility -> Risk) but makes each gate NaN-safe and
    regime-adaptive so the engine can actually emit trades.
    """

    # ---- 0. Warmup / bounds guard -------------------------------------
    if i < 200:
        return None
    if i >= len(df):
        return None

    row = df.iloc[i]

    # ---- 1. Pull required fields (NaN-safe) ---------------------------
    close = row.get("Close", np.nan)
    ema50 = row.get("EMA_50", np.nan)
    ema200 = row.get("EMA_200", np.nan)
    gex = row.get("GEX", np.nan)

    if not np.isfinite(close) or not np.isfinite(ema50) or not np.isfinite(ema200):
        return None
    if not np.isfinite(atr) or atr <= 0:
        return None

    # ---- 2. Regime filter (GEX) ---------------------------------------
    # Neutral fallback: if GEX is missing/NaN/zero, do NOT block the trade.
    if not np.isfinite(gex) or gex == 0:
        regime = "NEUTRAL"
    elif gex < 0:
        regime = "TREND"          # negative gamma -> trend-following
    else:
        regime = "MEAN_REVERSION" # positive gamma -> mean-reversion

    # ---- 3. Directional bias (EMA) ------------------------------------
    long_bias = (close > ema50) and (ema50 > ema200)
    short_bias = (close < ema50) and (ema50 < ema200)

    # ---- 4. Volatility band (ATR percentile, adaptive) ----------------
    # Use a rolling window of ATR to derive a regime-adaptive band.
    atr_window = df["ATR_14"].iloc[max(0, i - 100):i + 1] if "ATR_14" in df.columns else None
    if atr_window is not None and len(atr_window.dropna()) >= 20:
        atr_lo = np.nanpercentile(atr_window, 10)
        atr_hi = np.nanpercentile(atr_window, 90)
    else:
        # Fallback band relative to current ATR
        atr_lo = atr * 0.5
        atr_hi = atr * 2.0

    atr_ok = (atr >= atr_lo) and (atr <= atr_hi)
    if not atr_ok:
        return None

    # ---- 5. Risk sizing ------------------------------------------------
    stop_distance = atr * 1.5
    if stop_distance <= 0:
        return None

    # ---- 6. Signal assembly (hierarchical confluence) -----------------
    direction = None

    if regime == "TREND":
        # Trend-following: only trade WITH the EMA trend.
        if long_bias:
            direction = "LONG"
        elif short_bias:
            direction = "SHORT"

    elif regime == "MEAN_REVERSION":
        # Mean-reversion: fade extended moves, but still respect EMA_200
        # as the higher-timeframe anchor.
        if close > ema200 and close < ema50:
            direction = "LONG"   # pullback into uptrend
        elif close < ema200 and close > ema50:
            direction = "SHORT"  # bounce into downtrend

    else:  # NEUTRAL regime -> pure EMA+ATR confluence
        if long_bias:
            direction = "LONG"
        elif short_bias:
            direction = "SHORT"

    if direction is None:
        return None

    # ---- 7. Build trade plan ------------------------------------------
    if direction == "LONG":
        entry = close
        stop_loss = entry - stop_distance
        take_profit = entry + (stop_distance * 2.0)  # 2R target
    else:
        entry = close
        stop_loss = entry + stop_distance
        take_profit = entry - (stop_distance * 2.0)

    return {
        "direction": direction,
        "regime": regime,
        "entry": float(entry),
        "stop_loss": float(stop_loss),
        "take_profit": float(take_profit),
        "atr": float(atr),
        "stop_distance": float(stop_distance),
        "rr": 2.0,
        "reason": f"{regime}|EMA_bias|ATR_ok",
    }
